"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\"/>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>FLOP Faucet - devnet</title>\n  <link rel=\"stylesheet\" href=\"/assets/faucet.css\"/>\n  <script id=\"faucet-config\" type=\"application/json\">{\"network\":\"devnet\",\"quickAmountFlop\":25,\"linkedBaseFlop\":500,\"linkedCapFlop\":2000,\"walletConnectProjectId\":\"\",\"brightidEnabled\":true,\"brightidContext\":\"\",\"selfEnabled\":true,\"selfScope\":\"flop-faucet\",\"selfEndpoint\":\"https://faucet.flop.network/verify/self\",\"telegramLinks\":false}</script>\n  <script src=\"/assets/faucet.js\" defer></script>\n</head>\n<body>\n  <main class=\"shell\">\n    <section class=\"faucet-panel\" aria-labelledby=\"faucet-title\">\n      <div class=\"hero\">\n        <div class=\"hero-top\">\n          <span class=\"badge\"><span class=\"dot\" id=\"dot\"></span>devnet faucet</span>\n          <nav class=\"links\" aria-label=\"FLOP links\">\n            <a id=\"lnk-landing\" href=\"#\">Landing</a>\n            <a id=\"lnk-explorer\" href=\"#\">Explorer</a>\n          </nav>\n        </div>\n        <h1 id=\"faucet-title\">FL<span class=\"mark-zero\">0</span>P Faucet</h1>\n        <p class=\"sub\" id=\"mode-copy\">Choose quick dev funding or a larger verified-human grant.</p>\n      </div>\n      <div class=\"content\">\n\n        <div class=\"mode-switch\" aria-label=\"Funding type\">\n          <button type=\"button\" class=\"mode-btn active\" id=\"mode-quick\" aria-pressed=\"true\">\n            <b>Quick fund</b>\n            <span>25 FLOP for dev testing</span>\n          </button>\n          <button type=\"button\" class=\"mode-btn\" id=\"mode-linked\" aria-pressed=\"false\">\n            <b>Verified human</b>\n            <span>500-2000 FLOP by proof + score</span>\n          </button>\n        </div>\n\n        <div class=\"fund-form\">\n          <div class=\"row\">\n            <label for=\"addr\">Your FLOP address <span class=\"label-hint\">(SS58)</span></label>\n          </div>\n          <input id=\"addr\" placeholder=\"5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY\" autocomplete=\"off\"/>\n          <select id=\"acct\" hidden></select>\n          <div class=\"wallet-actions\">\n            <span class=\"wallet-hint\">Have a wallet?</span>\n            <button type=\"button\" class=\"link-btn\" id=\"connect\">Connect wallet</button>\n\n            <span class=\"wallet-sep\">·</span>\n            <span class=\"wallet-hint\">No wallet?</span>\n            <button type=\"button\" class=\"link-btn\" id=\"burner\">Generate a test address</button>\n            <button type=\"button\" class=\"link-btn\" id=\"copy\" hidden>Copy</button>\n          </div>\n\n          <div class=\"linked-fields\" id=\"linked-fields\" hidden>\n            <div>\n              <div class=\"field-head\">\n                <label for=\"identity\">Human identity</label>\n                <span class=\"field-actions\">\n                  <button type=\"button\" class=\"link-btn\" id=\"evm\">Connect human wallet</button>\n                </span>\n              </div>\n              <input id=\"identity\" placeholder=\"0x... EVM address for Human Passport / Guild\" autocomplete=\"off\" inputmode=\"text\"/>\n              <p class=\"field-help\">Connect the EVM wallet with your Human Passport or Guild score. Funds still go only to the FLOP address above.</p>\n            </div>\n            <div class=\"personhood-methods\" id=\"personhood-methods\">\n              <span class=\"methods-label\">No EVM wallet? Prove personhood on your FLOP address:</span>\n              <div class=\"methods-actions\"><button type=\"button\" class=\"link-btn\" id=\"verify-self\">Verify with Self</button></div>\n              <div class=\"method-panel\" id=\"method-panel\" hidden></div>\n            </div>\n            <div class=\"human-steps\">\n              <span><b>1. FLOP wallet</b>Receives the grant</span>\n              <span><b>2. Human wallet</b>Proves personhood</span>\n              <span><b>3. Score</b>Sets final amount</span>\n            </div>\n\n          </div>\n\n          <button class=\"primary-btn\" id=\"go\">Request 25 FLOP</button>\n        </div>\n\n        <div class=\"out\" id=\"out\"></div>\n        <div class=\"meta\">\n          <div>network - <b>devnet</b></div>\n          <div>node - <a id=\"node\" target=\"_blank\" rel=\"noopener\" href=\"#\">-</a></div>\n          <div>signer - <b id=\"signer\">-</b></div>\n          <div>status - <b id=\"status\">checking...</b></div>\n        </div>\n        <p class=\"hint\">No wallet? Install <a href=\"https://polkadot.js.org/extension/\" target=\"_blank\" rel=\"noopener\">Polkadot.js</a>, <a href=\"https://talisman.xyz/\" target=\"_blank\" rel=\"noopener\">Talisman</a>, or <a href=\"https://www.subwallet.app/\" target=\"_blank\" rel=\"noopener\">SubWallet</a>. They support FLOP with SS58 prefix 42. Ledger hardware wallets work through those extensions. <span id=\"brave-note\"></span></p>\n      </div>\n    </section>\n  </main>\n<script type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092\" integrity=\"sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"98ccdb03ee5f478f8b235d9c5f10bd87\",\"spa\":2}' crossorigin=\"anonymous\"></script>\n</body>\n</html>"
