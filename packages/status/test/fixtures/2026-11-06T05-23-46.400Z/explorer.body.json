tor Rewards\\\",\\\"economicsSummaryDistributions\\\":\\\"Distributions\\\",\\\"economicsRewardsLoading\\\":\\\"Loading reward distributions...\\\",\\\"economicsRewardsEmpty\\\":\\\"No reward distributions found.\\\",\\\"economicsVestingAllPallets\\\":\\\"All Pallets\\\",\\\"economicsVestingWorkVesting\\\":\\\"Work Vesting\\\",\\\"economicsVestingAllStatus\\\":\\\"All Status\\\",\\\"economicsVestingVested\\\":\\\"Vested\\\",\\\"economicsVestingClaimed\\\":\\\"Claimed\\\",\\\"economicsVestingRevoked\\\":\\\"Revoked\\\",\\\"economicsVestingLoading\\\":\\\"Loading vesting grants...\\\",\\\"economicsVestingEmpty\\\":\\\"No vesting grants found.\\\",\\\"economicsVestingNote\\\":\\\"Locked FLOP grants from two programs. Work vesting holds miners’ Ignition Grants, which unlock as the miner delivers its pledged capacity. Airdrop holds the miner, validator and agent airdrops, which unlock evenly over 90 days; a miner’s share also scales with its mainnet performance. The team receives no genesis allocation, so no team grants appear here.\\\",\\\"economicsTabRewards\\\":\\\"Rewards\\\",\\\"economicsTabVesting\\\":\\\"Vesting\\\",\\\"miningCalibrationLoading\\\":\\\"Loading calibrations...\\\",\\\"miningCalibrationEmpty\\\":\\\"No calibrations found.\\\",\\\"miningFilterAll\\\":\\\"All\\\",\\\"miningStatusCompleted\\\":\\\"Completed\\\",\\\"miningStatusRevoked\\\":\\\"Revoked\\\",\\\"miningGhostTasksLoading\\\":\\\"Loading ghost tasks...\\\",\\\"miningGhostTasksEmpty\\\":\\\"No ghost tasks found.\\\",\\\"miningSessionsLoading\\\":\\\"Loading sessions...\\\",\\\"miningSessionsEmpty\\\":\\\"No session tokens found.\\\",\\\"miningMinersLoading\\\":\\\"Loading miners...\\\",\\\"miningMinersEmpty\\\":\\\"No miners registered.\\\",\\\"miningSlashHistoryLoading\\\":\\\"Loading slash history...\\\",\\\"miningSlashHistoryEmpty\\\":\\\"No miner slash events.\\\",\\\"miningYes\\\":\\\"Yes\\\",\\\"miningNo\\\":\\\"No\\\",\\\"miningTabMiners\\\":\\\"Miners\\\",\\\"miningTabCalibration\\\":\\\"Calibration\\\",\\\"miningTabGhostTasks\\\":\\\"Ghost Tasks\\\",\\\"miningTabSlashHistory\\\":\\\"Slash History\\\",\\\"miningTabSessions\\\":\\\"Sessions\\\",\\\"slashingSummaryValidator\\\":\\\"Validator Slashes\\\",\\\"slashingSummaryMiner\\\":\\\"Miner Slashes\\\",\\\"slashingSummaryDa\\\":\\\"DA Audit Slashes\\\",\\\"slashingTimelineTitle\\\":\\\"Slash Events Timeline\\\",\\\"slashingFilterAll\\\":\\\"All\\\",\\\"slashingFilterValidators\\\":\\\"Validators\\\",\\\"slashingFilterMiners\\\":\\\"Miners\\\",\\\"slashingEmpty\\\":\\\"No slash events recorded.\\\",\\\"slashingRemovedEjectedBlacklisted\\\":\\\"ejected / blacklisted\\\",\\\"accountTabTransactions\\\":\\\"Transactions\\\",\\\"accountTabHtlcs\\\":\\\"HTLCs\\\",\\\"accountTabEscrows\\\":\\\"Escrows\\\",\\\"accountTabPouiProofs\\\":\\\"PoI Proofs\\\",\\\"accountTabAgentWallet\\\":\\\"Agent Wallet\\\",\\\"accountSectionTransactionHistory\\\":\\\"Transaction History\\\",\\\"accountSectionHtlcHistory\\\":\\\"HTLC History\\\",\\\"accountSectionEscrowHistory\\\":\\\"Escrow History\\\",\\\"accountSectionPouiProofSubmissions\\\":\\\"PoI Proof Submissions\\\",\\\"accountWalletStatus\\\":\\\"Status\\\",\\\"accountWalletPerTxLimit\\\":\\\"Per-TX Limit\\\",\\\"accountWalletDailyCap\\\":\\\"Daily Cap\\\",\\\"accountWalletOwner\\\":\\\"Owner\\\",\\\"accountWalletTotalFunded\\\":\\\"Total Funded\\\",\\\"accountWalletCreated\\\":\\\"Created\\\",\\\"accountDetailCopiedToast\\\":\\\"Copied to clipboard\\\",\\\"accountDetailTitle\\\":\\\"Account Details\\\",\\\"accountDetailAddress\\\":\\\"Address\\\",\\\"accountDetailBalance\\\":\\\"Balance\\\",\\\"accountDetailInformation\\\":\\\"Account Information\\\",\\\"accountDetailNonce\\\":\\\"Nonce\\\",\\\"accountDetailFirstSeen\\\":\\\"First Seen\\\",\\\"accountInferenceSpentTitle\\\":\\\"Inference spent\\\",\\\"accountInferenceSpentSubtitle\\\":\\\"{settled} of {total} channels settled\\\",\\\"accountTabComputeChannels\\\":\\\"Compute Channels\\\",\\\"accountSectionComputeChannels\\\":\\\"Compute Channels\\\",\\\"computeChannelColChannel\\\":\\\"Channel\\\",\\\"computeChannelColMiner\\\":\\\"Miner\\\",\\\"computeChannelColStatus\\\":\\\"Status\\\",\\\"computeChannelColMinerPaid\\\":\\\"Miner Paid\\\",\\\"computeChannelColAggregateGn\\\":\\\"Aggregate Gₙ\\\",\\\"computeChannelColOpened\\\":\\\"Opened\\\",\\\"computeChannelColUpdated\\\":\\\"Updated\\\",\\\"accountInferenceSpentError\\\":\\\"Couldn't load inference spend\\\",\\\"accountComputeChannelsError\\\":\\\"Couldn't load compute channels\\\",\\\"headerItemModels\\\":\\\"Models\\\",\\\"modelsPageTitle\\\":\\\"Models\\\",\\\"modelsPageLoading\\\":\\\"Loading models…\\\",\\\"modelsEmpty\\\":\\\"No models registered on-chain.\\\",\\\"modelsLoadError\\\":\\\"Could not load models from the indexer.\\\",\\\"modelsCount\\\":\\\"{count, number} registered\\\",\\\"modelsColHash\\\":\\\"Model Hash\\\",\\\"modelsColStatus\\\":\\\"Verification\\\",\\\"modelsColPrice\\\":\\\"Reference price (FLOP / effective GFLOP)\\\",\\\"modelsColEnforce\\\":\\\"Measured Root\\\",\\\"modelsStatusPending\\\":\\\"Pending\\\",\\\"modelsStatusVerified\\\":\\\"Verified\\\",\\\"modelsStatusDeprecated\\\":\\\"Deprecated\\\",\\\"modelsStatusRevoked\\\":\\\"Revoked\\\",\\\"modelsEnforceYes\\\":\\\"Enforced\\\",\\\"modelsEnforceNo\\\":\\\"Off\\\",\\\"htlcPaymentLabel\\\":\\\"Payment\\\",\\\"htlcEvidenceLabel\\\":\\\"Evidence\\\",\\\"htlcTimeoutPathLabel\\\":\\\"Timeout\\\",\\\"htlcObservationHeadLabel\\\":\\\"Head\\\",\\\"htlcVerifierRefLabel\\\":\\\"Verifier\\\",\\\"htlcDetailLockStatus\\\":\\\"Lock\\\",\\\"htlcPaymentStatusTitle\\\":\\\"Fund payment status\\\",\\\"htlcEvidenceStatusTitle\\\":\\\"Work evidence status\\\",\\\"htlcObservationHeadTitle\\\":\\\"Finalized or best head\\\",\\\"kolBack\\\":\\\"Back to leaderboard\\\",\\\"kolCampaign\\\":\\\"Campaign status\\\",\\\"kolCampaignNote\\\":\\\"Signup is simulated. Payouts and the work-weighted lottery are inactive; period boundaries, eligibility and reward caps still need agreement.\\\",\\\"kolCohort\\\":\\\"Referred wallet cohort\\\",\\\"kolCohortNote\\\":\\\"Synthetic addresses; account links open the explorer. Amounts are sample FLOP, not live balances. Wallet count means first funded and attributed wallets in the cohort.\\\",\\\"kolDay\\\":\\\"24h\\\",\\\"kolDeltaNote\\\":\\\"Second lines compare with the preceding equal-length window. Net change sums the changes in held, inference paid and HTLC paid; informational only. Missing snapshots stay unavailable.\\\",\\\"kolEmpty\\\":\\\"No public referrers in this period.\\\",\\\"kolFormula\\\":\\\"Certified work = settled inference paid + inference received + settled HTLC payments. FLOP held never contributes to rank. This preview uses illustrative windows, not approved payout periods.\\\",\\\"kolHeld\\\":\\\"FLOP held\\\",\\\"kolHeldDelta\\\":\\\"Change in FLOP held\\\",\\\"kolHtlc\\\":\\\"HTLC paid\\\",\\\"kolMethod\\\":\\\"How ranking works\\\",\\\"kolMockVerification\\\":\\\"Sample verification status; no real handle ownership has been checked.\\\",\\\"kolMonth\\\":\\\"30d\\\",\\\"kolNet\\\":\\\"Net change\\\",\\\"kolNotFound\\\":\\\"Public referrer not found in this preview.\\\",\\\"kolPaid\\\":\\\"Inference paid\\\",\\\"kolPreview\\\":\\\"PROVISIONAL · SAMPLE DATA\\\",\\\"kolPreviewNote\\\":\\\"Fictional profiles, balances and verification states. No rewards or live chain activity are represented.\\\",\\\"kolLive\\\":\\\"NETWORK ATTRIBUTION · LIVE DATA\\\",\\\"kolLiveNote\\\":\\\"Work: indexed best head. Balances: finalized daily observations; missing history is unavailable.\\\",\\\"kolTestCohort\\\":\\\"DEVNET TEST: labelled test referrers and wallets are excluded from acquisition totals and reward reporting.\\\",\\\"kolLiveCohortNote\\\":\\\"First-funded wallets attributed by the faucet. Account links show indexed history; balances use finalized daily observations.\\\",\\\"kolLiveFormula\\\":\\\"Certified work = settled inference paid + inference received + settled HTLC payments. FLOP held never contributes to rank. These rolling windows are informational, not approved payout periods.\\\",\\\"kolLiveError\\\":\\\"Unable to load live leaderboard data\\\",\\\"kolLiveErrorNote\\\":\\\"Connection to the indexer failed or the endpoint is not yet available. Please try again later.\\\",\\\"kolLoading\\\":\\\"Loading leaderboard data...\\\",\\\"kolPrivacy\\\":\\\"Only public referrers appear. Private referrers are excluded; shielded mode is deferred.\\\",\\\"kolProfile\\\":\\\"KOL / social handle\\\",\\\"kolPublicKols\\\":\\\"Public KOLs\\\",\\\"kolPool\\\":\\\"Weekly payout pool\\\",\\\"kolPoolPending\\\":\\\"To be announced\\\",\\\"kolPoolNote\\\":\\\"Total FLOP paid out each week, shared among the top public KOLs in proportion to certified work.\\\",\\\"kolReceived\\\":\\\"Inference received\\\",\\\"kolSubtitle\\\":\\\"The communities bringing useful work to FLOP.\\\",\\\"kolTableNote\\\":\\\"Amounts in FLOP · second line: period change\\\",\\\"kolTitle\\\":\\\"KOL leaderboard\\\",\\\"kolUnavailable\\\":\\\"Unavailable\\\",\\\"kolUnverified\\\":\\\"Unverified\\\",\\\"kolVsPrevious\\\":\\\"vs previous\\\",\\\"kolWallet\\\":\\\"Wallet\\\",\\\"kolWallets\\\":\\\"Funded wallets\\\",\\\"kolWeek\\\":\\\"7d\\\",\\\"kolWindow\\\":\\\"Window\\\",\\\"kolWindowEnd\\\":\\\"Window ends {date} UTC\\\",\\\"kolWindowUnavailable\\\":\\\"Window end unavailable\\\",\\\"kolWork\\\":\\\"Certified work\\\",\\\"kolWorkBreakdown\\\":\\\"Work breakdown\\\",\\\"kolDemoNote\\\":\\\"Interactive demo with fictional identities and balances. Email, wallet signing, social verification and funding are simulated. Nothing is sent or saved; steps reset on reload.\\\",\\\"kolJoin\\\":\\\"Join as KOL\\\",\\\"kolMyReferrals\\\":\\\"My referrals\\\",\\\"kolSetupNote\\\":\\\"Try the signup flow with Mira Compute’s sample profile.\\\",\\\"kolDemoProfile\\\":\\\"Demo profile\\\",\\\"kolSetupProgress\\\":\\\"{count} of 3 steps complete\\\",\\\"kolEmailStep\\\":\\\"1. Verify email\\\",\\\"kolEmailNote\\\":\\\"In the live flow, a magic link confirms your email. Try the confirmation below.\\\",\\\"kolVerifyEmail\\\":\\\"Simulate email confirmation\\\",\\\"kolEmailVerified\\\":\\\"Email confirmed · demo\\\",\\\"kolWalletStep\\\":\\\"2. Bind payout wallet\\\",\\\"kolWalletNote\\\":\\\"Connect a sample wallet, then simulate signing to prove ownership. The explorer’s header wallet is separate.\\\",\\\"kolConnectDemo\\\":\\\"Connect demo wallet\\\",\\\"kolSignChallenge\\\":\\\"Sample message: I control this wallet and bind it to Mira Compute’s FLOP profile.\\\",\\\"kolSignDemo\\\":\\\"Simulate signature\\\",\\\"kolWalletBound\\\":\\\"Wallet bound · demo\\\",\\\"kolSocialStep\\\":\\\"3. Verify social handles\\\",\\\"kolSocialNote\\\":\\\"Verify at least one handle on X, Instagram, TikTok, YouTube or Naver. Each verified handle is shown on your public profile.\\\",\\\"kolSocialChallenge\\\":\\\"Depending on the platform, a live check would ask you to post a temporary code, add it to your bio or channel description, or sign in. Press the platform’s button again to simulate a matching check.\\\",\\\"kolVerifyPlatform\\\":\\\"Verify {platform} · demo\\\",\\\"kolSimulatePlatform\\\":\\\"Simulate {platform} check\\\",\\\"kolPlatformVerified\\\":\\\"{platform} verified · demo\\\",\\\"kolPlatformX\\\":\\\"X\\\",\\\"kolPlatformInstagram\\\":\\\"Instagram\\\",\\\"kolPlatformTiktok\\\":\\\"TikTok\\\",\\\"kolPlatformYoutube\\\":\\\"YouTube\\\",\\\"kolPlatformNaver\\\":\\\"Naver\\\",\\\"kolGetLink\\\":\\\"Your community starts here\\\",\\\"kolPublicSetup\\\":\\\"This sample public profile appears on the leaderboard. Complete the three steps to preview your referral dashboard.\\\",\\\"kolOpenDashboard\\\":\\\"Get demo referral link\\\",\\\"kolCompleteSetup\\\":\\\"Complete all three steps\\\",\\\"kolYourLink\\\":\\\"Your sample referral link\\\",\\\"kolLinkNote\\\":\\\"Copy the demo invitation or open it to see what a referred user would experience. This link does not track referrals or earn rewards.\\\",\\\"kolCopyLink\\\":\\\"Copy link\\\",\\\"kolLinkCopied\\\":\\\"Sample link copied\\\",\\\"kolCopyManual\\\":\\\"Link selected. Copy it manually from the field.\\\",\\\"kolPreviewInvite\\\":\\\"Preview recipient experience\\\",\\\"kolDashboardNote\\\":\\\"Mira Compute’s existing demo account. All figures match the sample leaderboard.\\\",\\\"kolPayoutWallet\\\":\\\"Sample payout wallet\\\",\\\"kolDemoBound\\\":\\\"Sample email and wallet binding complete. No real identity has been verified.\\\",\\\"kolReplaySetup\\\":\\\"Replay signup demo\\\",\\\"kolSampleRank\\\":\\\"Sample rank\\\",\\\"kolDashboardWindow\\\":\\\"7d sample · ends 8 Sep 2026, UTC\\\",\\\"kolViewPublic\\\":\\\"View public profile\\\",\\\"kolInviteTitle\\\":\\\"You’re invited to FLOP\\\",\\\"kolInviteNote\\\":\\\"Preview the recipient’s journey with a sample referral code.\\\",\\\"kolInviteConsent\\\":\\\"In the live flow, continuing would attribute your first funded wallet to Mira Compute’s public referral cohort. Your wallet activity would contribute to their leaderboard score.\\\",\\\"kolReferralCode\\\":\\\"Sample referral code\\\",\\\"kolSimulateFunding\\\":\\\"Simulate wallet creation \\u0026 funding\\\",\\\"kolFundingDone\\\":\\\"Funding simulated\\\",\\\"kolAttributionDone\\\":\\\"Sample wallet attributed to Mira Compute\\\",\\\"kolAttributionNote\\\":\\\"This illustrates one wallet already in the demo cohort. No keys, funds or referral records were created; the leaderboard stays unchanged.\\\",\\\"kolCreateBurnerWallet\\\":\\\"Create dev account \\u0026 claim faucet\\\",\\\"kolCreatingBurner\\\":\\\"Creating dev account...\\\",\\\"kolWalletCreatedAttributed\\\":\\\"Dev account created \\u0026 attributed\\\",\\\"kolAttributionDoneReal\\\":\\\"Dev account attributed to referrer\\\",\\\"kolAttributionNoteReal\\\":\\\"Dev account created and credited from the devnet faucet. Attribution was registered with your referral code.\\\",\\\"kolInviteUnknown\\\":\\\"Sample invitation not found\\\",\\\"kolInviteUnknownNote\\\":\\\"Only the sample link from My referrals works in this demo. No referral has been recorded.\\\",\\\"channelLineageTitle\\\":\\\"Session continuation\\\",\\\"channelLineageSource\\\":\\\"Unverified off-chain metadata; each channel settles separately.\\\",\\\"channelLineageParent\\\":\\\"Continued from channel\\\",\\\"channelLineageReceipt\\\":\\\"At receipt\\\",\\\"channelLineageRoot\\\":\\\"Receipt root\\\",\\\"channelLineageGn\\\":\\\"Aggregate Gₙ\\\",\\\"channelTransitionTitle\\\":\\\"Latest transition\\\",\\\"channelTransitionUnavailable\\\":\\\"Unavailable\\\",\\\"channelTransitionUnavailableNote\\\":\\\"The event that set this status is not indexed in its block (a legacy row or a reorged-out block).\\\",\\\"channelTransitionNotReported\\\":\\\"This indexer does not report status transitions.\\\",\\\"channelEventsTitle\\\":\\\"Event history\\\",\\\"channelEventsLoading\\\":\\\"Loading channel events…\\\",\\\"channelEventsEmpty\\\":\\\"No events indexed for this channel.\\\",\\\"channelEventsError\\\":\\\"Could not load the event history from the indexer.\\\",\\\"channelEventEvent\\\":\\\"Event\\\",\\\"channelEventCall\\\":\\\"Call\\\",\\\"channelEventSigner\\\":\\\"Signer\\\",\\\"channelEventTransaction\\\":\\\"Transaction\\\",\\\"channelEventBlock\\\":\\\"Block\\\",\\\"channelEventHead\\\":\\\"Observation head\\\",\\\"channelEventPayload\\\":\\\"Payload\\\",\\\"channelDetailTitle\\\":\\\"Compute Channel\\\",\\\"channelDetailPageLoadError\\\":\\\"Couldn't load compute channel\\\",\\\"channelDetailPageLoadErrorDesc\\\":\\\"The indexer request failed. This does not mean the channel doesn't exist \u2014 try again shortly.\\\",\\\"modelsSubtitle\\\":\\\"Registered models, their specifications and provenance.\\\",\\\"modelsParameters\\\":\\\"Registered parameters\\\",\\\"modelsBillions\\\":\\\"{count, number} billion\\\",\\\"modelsPrecision\\\":\\\"Precision / quantization\\\",\\\"modelsPublisher\\\":\\\"Publisher / uploader\\\",\\\"modelsRegistered\\\":\\\"Registered on FLOP (UTC)\\\",\\\"modelsMinVram\\\":\\\"Minimum VRAM\\\",\\\"modelsArchitecture\\\":\\\"Architecture\\\",\\\"modelsGflopsPerToken\\\":\\\"GFLOP per token\\\",\\\"modelsTasks\\\":\\\"Capabilities\\\",\\\"modelsDetails\\\":\\\"Model details\\\",\\\"modelsNotRecorded\\\":\\\"Not recorded\\\",\\\"modelsMetadataUnavailable\\\":\\\"Model metadata is temporarily unavailable.\\\",\\\"modelsFinalizedHead\\\":\\\"Finalized registry · block #{block, number}\\\",\\\"modelsHeadUnavailable\\\":\\\"Registry head unavailable\\\",\\\"modelsOffline\\\":\\\"The indexer is disconnected. Model registry unavailable.\\\",\\\"modelsStatusUnknown\\\":\\\"Unknown\\\",\\\"modelsHuggingFace\\\":\\\"View on Hugging Face\\\",\\\"modelsTee\\\":\\\"Supported TEE platforms\\\",\\\"modelsLicenseHash\\\":\\\"License hash\\\",\\\"modelsNoLicenseHash\\\":\\\"No license hash registered\\\",\\\"modelsApprovers\\\":\\\"Approved by\\\",\\\"modelsSources\\\":\\\"Weight sources\\\",\\\"modelsMirrorsUnavailable\\\":\\\"Source mirrors are temporarily unavailable.\\\",\\\"modelsBenchmarks\\\":\\\"Registered benchmarks\\\",\\\"modelsBenchmarkVerified\\\":\\\"Verified at block\\\",\\\"modelsBenchmarkExpires\\\":\\\"Expires at block\\\",\\\"modelsVerifier\\\":\\\"Verified by\\\",\\\"modelsCopyHash\\\":\\\"Copy model hash\\\",\\\"modelsHashCopied\\\":\\\"Model hash copied.\\\",\\\"modelsCopyFailed\\\":\\\"Could not copy. Select the hash and copy it manually.\\\",\\\"modelsVersion\\\":\\\"Version {version}\\\",\\\"modelsParametersHint\\\":\\\"Recorded in whole billions.\\\",\\\"agentOpenrouterBack\\\":\\\"← Connect to FLOP\\\",\\\"agentOpenrouterTitle\\\":\\\"Agent client onboarding\\\",\\\"agentOpenrouterIntro\\\":\\\"Guides for the ten agent clients shown in the OpenRouter list. Listing does not mean FLOP integration is available or that paid inference has passed. Follow each guide for its setup and verification status.\\\",\\\"agentOpenrouterAccessTitle\\\":\\\"Devnet pilot access\\\",\\\"agentOpenrouterAccessLead\\\":\\\"Public wallet enrollment grants up to 20,000 devnet FLOP for 24 hours. Approved Tailscale users have a separate seven-day allowance. Each client guide explains its enrollment path.\\\",\\\"agentOpenrouterCatalogPrompt\\\":\\\"Before an agent turn, check the\\\",\\\"agentOpenrouterCatalogLink\\\":\\\"live model catalog\\\",\\\"agentOpenrouterCatalogLimits\\\":\\\"for an exact model ID and its supported_parameters. A model without tools cannot run a full agent tool loop.\\\",\\\"agentOpenrouterStatusPilot\\\":\\\"Devnet pilot setup\\\",\\\"agentOpenrouterStatusGuide\\\":\\\"Setup guide\\\",\\\"agentOpenrouterHermesGuide\\\":\\\"Open Hermes pilot setup\\\",\\\"agentOpenrouterGuide\\\":\\\"Read onboarding guide\\\",\\\"hermesPageBack\\\":\\\"← Connect to FLOP\\\",\\\"hermesPageTitle\\\":\\\"Hermes Desktop on FLOP devnet\\\",\\\"hermesPageIntro\\\":\\\"This pilot uses an installable Hermes model provider that enrolls through the FLOP tailnet. Outside the tailnet, a funded wallet can enroll for a gateway key instead. A paid Desktop turn has not yet been verified.\\\",\\\"hermesPageAccessTitle\\\":\\\"Join the approved tailnet\\\",\\\"hermesPageAccessCopy\\\":\\\"Ask the devnet operator to approve your Tailscale user ID. On that device, check gateway health and the live model catalog. Use only the exact model IDs shown there.\\\",\\\"hermesPageHealthLink\\\":\\\"Gateway health\\\",\\\"hermesPageModelsLink\\\":\\\"Live models\\\",\\\"hermesPageInstallTitle\\\":\\\"Install the FLOP provider\\\",\\\"hermesPageInstallCopy\\\":\\\"Update Hermes, then open this install link on the same tailnet device. Review the Git repository path in Hermes before confirming installation.\\\",\\\"hermesPageInstallAction\\\":\\\"Install in Hermes\\\",\\\"hermesPageInstallFallback\\\":\\\"If your browser does not open Hermes, install the same repository subdirectory from a terminal:\\\",\\\"hermesPagePluginSource\\\":\\\"Review plugin source\\\",\\\"hermesPageConnectTitle\\\":\\\"Connect without pasting a key\\\",\\\"hermesPageConnectCopy\\\":\\\"The provider uses your approved Tailscale identity to enroll. Run:\\\",\\\"hermesPageModelCopy\\\":\\\"Choose FLOP Devnet and an exact live model in the model picker, then open Desktop:\\\",\\\"hermesPageCacheCopy\\\":\\\"The credential is stored privately in Hermes and in ~/.flop/devnet-agent-key.json (mode 0600), shared with the FLOP CLI. The pilot allowance is 25 FLOP over seven days; rotating a key does not reset spend.\\\",\\\"hermesPageFallbackTitle\\\":\\\"CLI fallback\\\",\\\"hermesPageFallbackCopy\\\":\\\"For another client, the explicit devnet command reports your model and remaining quota without printing the key:\\\",\\\"hermesPageLauncherCopy\\\":\\\"For an older Hermes build, the FLOP launcher remains available:\\\",\\\"hermesPageVerifyTitle\\\":\\\"Verify a paid turn\\\",\\\"hermesPageVerifyCopy\\\":\\\"Hermes Desktop's Test action may stop at model discovery. A real paid request must return a FLOP channel receipt. The local smoke test caps one request at 5 FLOP and prompts for the key privately.\\\",\\\"hermesPageSmokeLink\\\":\\\"Download the smoke test\\\",\\\"hermesPageVerifyLimits\\\":\\\"Check supported_parameters in the live catalog before enabling tools. Without tools, the model supports an inference pilot only; a full Hermes tool loop remains unverified.\\\",\\\"hermesPageSkillTitle\\\":\\\"Agent onboarding skill\\\",\\\"hermesPageSkillCopy\\\":\\\"The skill checks readiness and guides this setup. It does not request your key in chat.\\\",\\\"hermesPageSkillLink\\\":\\\"Read or download the skill\\\",\\\"hermesPagePublicAccessTitle\\\":\\\"Check the public gateway\\\",\\\"hermesPagePublicAccessCopy\\\":\\\"Check gateway health and the live model catalog. Use only the exact model IDs shown there.\\\",\\\"hermesPagePublicKeyTitle\\\":\\\"Get a devnet key with your wallet\\\",\\\"hermesPagePublicKeyCopy\\\":\\\"Fund a wallet address with at least 1 FLOP from the faucet, then sign the gateway's one-time enrollment challenge with that wallet's sr25519 key. Each address gets one 20,000 FLOP allowance that expires after 24 hours. This page never asks for a seed phrase and does not sign for you.\\\",\\\"agentClientPublicEnrollCopy\\\":\\\"This guide describes a configuration path, not a verified coding integration. Get a devnet key by enrolling a wallet address: fund it with at least 1 FLOP from the faucet, fetch a one-time challenge, sign the challenge message with the wallet's sr25519 key in your own wallet or signing tool, and submit the signature. Each address gets one allowance of 20,000 FLOP that expires after 24 hours. This page never asks for a seed phrase and does not sign for you. With curl and jq installed, run this in the shell that launches your client.\\\",\\\"hermesPagePublicProviderTitle\\\":\\\"Native Hermes provider: tailnet only for now\\\",\\\"hermesPagePublicProviderCopy\\\":\\\"The native FLOP provider still enrolls through the FLOP tailnet. The FLOP CLI enrolls a wallet on the public gateway by default (flop --network devnet agent credential), but neither is publicly installable yet. Until they are, use your key with an OpenAI-compatible agent client:\\\",\\\"agentMcpDevnetTitle\\\":\\\"Devnet MCP: read-only\\\",\\\"agentMcpDevnetCopy\\\":\\\"Use the hosted devnet MCP at mcp.flop.network for read-only query, discovery, verification, and catalog tools. It has no signer-backed transaction tools.\\\",\\\"agentApiDevnetTitle\\\":\\\"Devnet inference API\\\",\\\"agentApiDevnetCopy\\\":\\\"The OpenAI-compatible gateway is public at api.flop.network. Pilot users need a scoped devnet credential and an exact model ID from the live catalog.\\\",\\\"agentApiGatewayHealth\\\":\\\"Gateway health\\\",\\\"agentApiLiveModels\\\":\\\"Live models\\\",\\\"agentApiPublicPlannedTitle\\\":\\\"Public API and OpenAPI\\\",\\\"agentApiPublicPlannedCopy\\\":\\\"The public api.flop.network host serves its OpenAPI document at /openapi.json. Check /health before depending on it.\\\",\\\"transactionUnsigned\\\":\\\"Unsigned / inherent\\\",\\\"analyticsDaBlobsTracked\\\":\\\"Blobs tracked\\\",\\\"analyticsDaStoredShown\\\":\\\"Stored\\\",\\\"analyticsDaSizeShown\\\":\\\"Stored size\\\",\\\"analyticsDaMissedShown\\\":\\\"Missed audits\\\",\\\"analyticsHoldersChainAccounts\\\":\\\"Chain accounts\\\",\\\"analyticsHoldersLoading\\\":\\\"Reading holder balances from chain state…\\\",\\\"analyticsHoldersError\\\":\\\"Holder data could not be loaded \u2014 the indexer is unreachable. This is not a report of zero balances.\\\",\\\"analyticsHoldersUnavailable\\\":\\\"Holder data is unavailable: the indexer has not completed a chain-state scan yet. This view refreshes automatically.\\\",\\\"analyticsHoldersEmpty\\\":\\\"No account holds a balance on this chain yet.\\\",\\\"analyticsHoldersObserved\\\":\\\"observed {age}s ago\\\",\\\"analyticsHoldersStale\\\":\\\"A refresh is in progress.\\\",\\\"analyticsPerformanceAvgBlockTime\\\":\\\"Avg block time\\\",\\\"analyticsPerformanceTotalExtrinsics\\\":\\\"Total extrinsics\\\",\\\"analyticsPerformanceExtrinsics24h\\\":\\\"Extrinsics (24h)\\\",\\\"connectOptionsUnavailable\\\":\\\"Connection options are unavailable. Check the gateway and reload this page.\\\",\\\"connectPromptsTitle\\\":\\\"Let your agent onboard itself\\\",\\\"connectPromptsLead\\\":\\\"Paste a prompt into Claude Code, Codex, Hermes or another agent. Neither prompt needs a parent credential.\\\",\\\"connectPromptExploreTitle\\\":\\\"1. Explore the devnet (read-only)\\\",\\\"connectPromptExplorePurpose\\\":\\\"Your agent reads the agent guide, queries the hosted MCP, and reports which models are live, what a request costs, and where the docs are wrong. It signs and spends nothing.\\\",\\\"connectPromptFirstRequestTitle\\\":\\\"2. Get a key and make one paid request\\\",\\\"connectPromptFirstRequestPurposePublic\\\":\\\"Your agent creates a throwaway devnet wallet, funds it from the faucet, signs a challenge to enroll its own gateway key (20,000 FLOP for 24 hours), makes one paid inference request, and checks its on-chain settlement receipt.\\\",\\\"connectPromptFirstRequestPurposeTailnet\\\":\\\"Your agent gets the gateway key for your Tailscale identity, makes one paid inference request, and checks its on-chain settlement receipt. Each approved Tailscale user has one allowance, 25 FLOP for 7 days from the first enrollment; enrolling again only replaces the key. To get approved or for a new allowance, ask the devnet operator.\\\",\\\"connectPromptsReadyNote\\\":\\\"The second prompt stops unless the gateway health check reports ok, which needs at least one live model.\\\",\\\"connectPromptCopy\\\":\\\"Copy prompt\\\",\\\"connectPromptCopied\\\":\\\"Copied\\\",\\\"connectPromptSelected\\\":\\\"Selected: press Ctrl+C\\\",\\\"channelVerifierRefMissing\\\":\\\"The indexer reports a verifier reference, but no reference is available for this channel. This does not prove verification.\\\",\\\"headerNavParticipate\\\":\\\"Participate\\\",\\\"headerItemBecomeValidator\\\":\\\"Become a validator\\\",\\\"headerItemBecomeMiner\\\":\\\"Become a miner\\\",\\\"headerItemConnectAgent\\\":\\\"Connect an agent\\\",\\\"accountHistoryLoadMore\\\":\\\"Load more\\\",\\\"accountHistoryLoading\\\":\\\"Loading…\\\",\\\"accountHistoryLoadError\\\":\\\"History could not be loaded.\\\",\\\"marketTapeSkuNote\\\":\\\"GPU SKU shows attested miner inventory at settlement, not the GPU used for this channel. Unavailable means no historical inventory could be read.\\\",\\\"accountHistoryRetry\\\":\\\"Retry\\\",\\\"validatorUptimeUnavailable\\\":\\\"Uptime unavailable: no observation window or eligible samples have been published.\\\",\\\"activityFilterAll\\\":\\\"All\\\",\\\"activityFilterActivity\\\":\\\"User activity\\\",\\\"activityFilterInference\\\":\\\"Inference\\\",\\\"activityFilterHtlc\\\":\\\"HTLC\\\",\\\"activityFilterTransfers\\\":\\\"Transfers\\\",\\\"activityFilterRewards\\\":\\\"Period rewards\\\",\\\"activityFilterOther\\\":\\\"Other\\\",\\\"activityFilterSystem\\\":\\\"System\\\",\\\"activityFilterLabel\\\":\\\"Activity type\\\",\\\"activityFilterHelp\\\":\\\"User activity hides routine timestamp and finality calls. Period rewards exclude per-block subsidies.\\\",\\\"activityColActivity\\\":\\\"Activity\\\",\\\"activityCount\\\":\\\"{count} user transactions\\\",\\\"activityEmpty\\\":\\\"No matching activity.\\\",\\\"activityHead\\\":\\\"Indexed best chain; block badges show finality.\\\",\\\"activityError\\\":\\\"Could not load activity.\\\",\\\"activityBestHead\\\":\\\"Best head\\\",\\\"blockRewardsTitle\\\":\\\"Reward distribution\\\",\\\"blockRewardsPeriod\\\":\\\"Distribution for {count} blocks\\\",\\\"blockRewardsScheduled\\\":\\\"Scheduled reward\\\",\\\"blockRewardsMiners\\\":\\\"Miners\\\",\\\"blockRewardsValidators\\\":\\\"Validators\\\",\\\"blockRewardsAgentPool\\\":\\\"Agent pool\\\",\\\"blockRewardsStakerPool\\\":\\\"Staker pool\\\",\\\"blockRewardsLabs\\\":\\\"Labs subsidy\\\",\\\"blockRewardsFoundation\\\":\\\"Foundation subsidy\\\",\\\"blockRewardsNoPeriod\\\":\\\"No period reward distribution in this block.\\\",\\\"blockRewardsNoSubsidy\\\":\\\"No subsidy recorded in this block.\\\",\\\"blockRewardsUnavailable\\\":\\\"Unavailable\\\",\\\"blockRewardsFailed\\\":\\\"Reward distribution failed in this block.\\\",\\\"blockRewardsRecipients\\\":\\\"Recorded recipients\\\",\\\"blockRewardsPoolsNote\\\":\\\"Agent and staker rewards are held in pools; individual payouts are not implemented.\\\",\\\"walletLabs\\\":\\\"Labs\\\",\\\"walletFoundation\\\":\\\"Foundation\\\",\\\"headerItemVouchers\\\":\\\"Vouchers\\\",\\\"vouchersTitle\\\":\\\"Testnet vouchers\\\",\\\"vouchersIntro\\\":\\\"Proposed cohort claims earned through verified testnet activity.\\\",\\\"vouchersStatus\\\":\\\"Proposal\\\",\\\"vouchersAvailability\\\":\\\"Voucher issuance, balances, transfers and redemption are not available yet.\\\",\\\"vouchersCohortMiner\\\":\\\"Miner\\\",\\\"vouchersCohortValidator\\\":\\\"Validator\\\",\\\"vouchersCohortAgent\\\":\\\"Agent\\\",\\\"vouchersMinerDescription\\\":\\\"Verified inference work contributes to the proposed miner cohort.\\\",\\\"vouchersValidatorDescription\\\":\\\"Validator activity contributes to the proposed validator cohort.\\\",\\\"vouchersAgentDescription\\\":\\\"Settled inference spend contributes to the proposed agent cohort.\\\",\\\"vouchersBalance\\\":\\\"Voucher balance\\\",\\\"vouchersUnavailable\\\":\\\"Unavailable\\\",\\\"vouchersActivityLink\\\":\\\"Explore activity\\\",\\\"vouchersActivityNote\\\":\\\"Recorded activity is not a voucher balance or a guaranteed mainnet allocation.\\\",\\\"vouchersRulesTitle\\\":\\\"How vouchers would work\\\",\\\"vouchersRules\\\":\\\"Cohort vouchers would be separate from testnet FLOP. They would not pay gas, fund compute or count as stake.\\\",\\\"vouchersRedemption\\\":\\\"Mainnet redemption would depend on an approved snapshot and the cohort’s unlock rules.\\\",\\\"vouchersAccountLink\\\":\\\"Testnet voucher status\\\",\\\"miningAvailabilityAvailable\\\":\\\"Available\\\",\\\"miningAvailabilityUnavailable\\\":\\\"Unavailable\\\",\\\"miningAvailabilityUnknown\\\":\\\"Availability unknown\\\",\\\"miningRegistrationRegistered\\\":\\\"Registered\\\",\\\"miningAvailabilitySource\\\":\\\"Registration: indexed best head. Availability: live gateway checks.\\\",\\\"miningAvailabilityCheckedAt\\\":\\\"Checked {time}\\\",\\\"miningSponsoredColumn\\\":\\\"Sponsored\\\",\\\"miningSponsoredNote\\\":\\\"Locked sponsor bond, owned by the sponsor. It counts toward the stake requirement on devnet/testnet but is not the miner's own stake.\\\",\\\"miningGpusColumn\\\":\\\"GPUs\\\",\\\"miningGpuSelfReported\\\":\\\"self-reported\\\",\\\"miningGpuAttested\\\":\\\"attested\\\",\\\"miningGpuDeclaredAt\\\":\\\"Declared at block #{block}\\\",\\\"miningGpuH100Equivalent\\\":\\\"H100-equivalent (reference)\\\",\\\"miningUnavailable\\\":\\\"Unavailable\\\",\\\"hermesPagePublicIntro\\\":\\\"Install the standalone FLOP launcher and connect Hermes to the public devnet. No FLOP repository access, Tailscale, or OAuth is required.\\\",\\\"hermesPagePublicInstallTitle\\\":\\\"Install the public launcher\\\",\\\"hermesPagePublicInstallCopy\\\":\\\"Requires Node.js 22+, curl, and Hermes 0.22.2. The installer verifies the immutable release checksum and preserves an existing FLOP CLI.\\\",\\\"hermesPagePublicLaunchTitle\\\":\\\"Connect and launch Hermes\\\",\\\"hermesPagePublicDoctorCopy\\\":\\\"Check readiness without creating a wallet or spending credit:\\\",\\\"hermesPagePublicLaunchCopy\\\":\\\"The launcher checks the live model and your key’s scope, creates and funds a devnet enrollment wallet when needed, then opens Hermes with an isolated terminal-only profile. Your signer and API key stay on your device.\\\",\\\"hermesPagePublicAllowanceCopy\\\":\\\"The trial grants up to 20,000 devnet FLOP for 24 hours at two requests per minute. Reconnecting does not renew it. Each request is capped at 1,000 FLOP and 512 output tokens; a run can make multiple requests.\\\",\\\"hermesPagePublicDiscoveryCopy\\\":\\\"The live model catalog is free to read without authentication. Inference requires a scoped gateway key. An empty catalog means no qualified model is available.\\\",\\\"hermesPagePublicNativeTitle\\\":\\\"Native public provider\\\",\\\"hermesPagePublicNativeCopy\\\":\\\"Git is also required. Launcher 0.4.5 bundles model provider 0.1.1, separate from the Hermes tool bundle. Keep the exported HERMES_HOME for every command. Run hermes pm repair to prepare its managed runtime before plugin installation; it creates no FLOP wallet. This ordering is qualified on Linux. Minimal Debian images need ca-certificates, curl, git, xz-utils and libatomic1 for the managed Hermes runtime. Connect your wallet allowance, and select FLOP Public Devnet and an offered model. Apply the bounded terminal settings in the onboarding skill before starting a conversation. Installation spends no credit. Enrollment needs an open trial window; paid Desktop acceptance remains pending.\\\",\\\"protocolAccountsTitle\\\":\\\"Foundation and Labs\\\",\\\"protocolAccountsLoading\\\":\\\"Loading protocol accounts…\\\",\\\"protocolAccountsError\\\":\\\"Could not load protocol accounts.\\\",\\\"protocolAccountsUnavailable\\\":\\\"Protocol account state is unavailable.\\\",\\\"protocolAccountsUnconfigured\\\":\\\"Foundation and Labs recipients are not configured.\\\",\\\"protocolAccountsFinalized\\\":\\\"Finalized block {block}\\\",\\\"protocolAccountsActive\\\":\\\"Subsidies active\\\",\\\"protocolAccountsInactive\\\":\\\"Subsidies inactive\\\",\\\"protocolAccountsBalance\\\":\\\"Total balance (free + reserved)\\\",\\\"protocolAccountsTotal\\\":\\\"Total subsidy received\\\",\\\"protocolAccountsBlockPayment\\\":\\\"Subsidy paid in this block\\\",\\\"protocolAccountsNoPayment\\\":\\\"No subsidy payment in this block\\\",\\\"protocolAccountsEnd\\\":\\\"Subsidy ends at block {block}\\\",\\\"validatorPackageTitle\\\":\\\"Validator onboarding package\\\",\\\"validatorPackageDescription\\\":\\\"{id} · {version} · FLOP Devnet · Linux amd64\\\",\\\"validatorPackageDownload\\\":\\\"Download package\\\",\\\"validatorPackageChecksum\\\":\\\"SHA-256 checksum\\\",\\\"validatorPackageUnavailable\\\":\\\"Package download unavailable. Do not start onboarding until a versioned package and checksum are published and verified.\\\",\\\"validatorIntakeLabel\\\":\\\"Availability and access updates\\\",\\\"validatorPackageAccess\\\":\\\"Administrator-assisted devnet onboarding. Self-service public testnet onboarding is not yet available.\\\",\\\"validatorOnboardingTitle\\\":\\\"Validate on FLOP\\\",\\\"validatorOnboardingIntro\\\":\\\"Join the FLOP Devnet with a dedicated node. No GPU or TEE is required.\\\",\\\"validatorPrepareTitle\\\":\\\"1. Prepare and send public host details\\\",\\\"validatorPrepareCopy\\\":\\\"Follow the package README, then send your hostname, public SS58 address and SSH host public key to your FLOP operations contact. The host key encrypts enrollment material; private keys stay on your host.\\\",\\\"validatorJoinTitle\\\":\\\"2. Receive access and funding, then join\\\",\\\"validatorJoinCopy\\\":\\\"Wait for enrollment, funding, the private DA peer directory and access-check confirmation, then run the join command and say “ready”. Joining registers the account and locks the live minimum stake.\\\",\\\"validatorActivationTitle\\\":\\\"3. Operations checks and activates\\\",\\\"validatorActivationCopy\\\":\\\"Operations reads registration, keys and the DA endpoint from the chain, checks connectivity and promotes your account. Run verification after activation is confirmed. “Ready” does not mean active.\\\",\\\"validatorManualLabel\\\":\\\"Full setup manual\\\",\\\"validatorStatusLabel\\\":\\\"View validators\\\",\\\"escrowsPageLoadError\\\":\\\"Could not load escrows.\\\",\\\"escrowDetailPageLoadError\\\":\\\"Could not load escrow.\\\",\\\"escrowLoadErrorDescription\\\":\\\"The indexer request failed. Try again shortly.\\\",\\\"operatorVersionTitle\\\":\\\"Operator software\\\",\\\"operatorVersionColumn\\\":\\\"Worker / node version\\\",\\\"operatorVersionUnknown\\\":\\\"Unknown\\\",\\\"operatorVersionUpgradeRequired\\\":\\\"Upgrade required\\\",\\\"operatorVersionMeetsMinimum\\\":\\\"Meets worker minimum\\\",\\\"operatorVersionUpgradeUnknown\\\":\\\"Upgrade status unknown\\\",\\\"operatorVersionReportStale\\\":\\\"Report stale; upgrade unknown\\\",\\\"operatorVersionNotReported\\\":\\\"Version not reported\\\",\\\"operatorVersionSelfReported\\\":\\\"Self-reported; not attested\\\",\\\"operatorVersionReportedAt\\\":\\\"Reported {time}\\\",\\\"operatorVersionStandardLatest\\\":\\\"Latest standard worker build\\\",\\\"operatorVersionMinimum\\\":\\\"Worker minimum\\\",\\\"operatorVersionLoading\\\":\\\"Loading release manifest…\\\",\\\"operatorVersionManifestUnavailable\\\":\\\"Release manifest unavailable; upgrade status unknown.\\\",\\\"operatorVersionMinerSource\\\":\\\"Versions: off-chain mailbox reports. Registry: indexed chain state. Reports expire after 15 minutes.\\\",\\\"operatorVersionHybridNote\\\":\\\"Build stamps do not distinguish standard and hybrid workers. Follow the controller upgrade guide for hybrid miners.\\\",\\\"operatorVersionManifest\\\":\\\"Release manifest\\\",\\\"operatorVersionValidatorBundle\\\":\\\"Published validator onboarding bundle\\\",\\\"operatorVersionValidatorSource\\\":\\\"Per-validator binary versions are not published. The bundle version and shared chain runtime do not establish installed binaries or upgrade status.\\\",\\\"operatorVersionUpgradeGuide\\\":\\\"Upgrade instructions\\\",\\\"marketsHourlyTab\\\":\\\"Hourly preview\\\",\\\"marketsHourlyTitle\\\":\\\"Hourly FRCR \u2014 draft\\\",\\\"marketsHourlyDescription\\\":\\\"Net miner revenue per reference GFLOP, grouped by settlement hour (UTC). Composite spot market across models and assurance tiers.\\\",\\\"marketsHourlyDraft\\\":\\\"Observational only. Hourly thresholds and activation are unapproved; no official rate is published.\\\",\\\"marketsHourlyFinalized\\\":\\\"Finalized observation head #{block}\\\",\\\"marketsHourlyLoading\\\":\\\"Loading hourly observations…\\\",\\\"marketsHourlyError\\\":\\\"Hourly data could not be loaded.\\\",\\\"marketsHourlyRetry\\\":\\\"Retry request\\\",\\\"marketsHourlyEmpty\\\":\\\"No hourly records returned.\\\",\\\"marketsHourlyHour\\\":\\\"Hour start (UTC)\\\",\\\"marketsHourlyPrice\\\":\\\"FLOP / reference GFLOP\\\",\\\"marketsHourlyVolume\\\":\\\"Reference GFLOPs\\\",\\\"marketsHourlyParticipants\\\":\\\"Trades / buyers / sellers\\\",\\\"marketsHourlyConcentration\\\":\\\"Largest seller volume share\\\",\\\"marketsHourlyStatus\\\":\\\"Observation status\\\",\\\"marketsHourlyIncomplete\\\":\\\"Incomplete data\\\",\\\"marketsHourlyNoTrades\\\":\\\"No trades\\\",\\\"marketsHourlyExcluded\\\":\\\"All trades excluded\\\",\\\"marketsHourlyBelowFloor\\\":\\\"Below provisional floors\\\",\\\"marketsHourlyObserved\\\":\\\"Observed; floors passed\\\",\\\"marketsLegacyComposite\\\":\\\"Legacy v0 composite diagnostic across models and SKUs. This is not a standardized reference product. Below-floor days remain gaps.\\\",\\\"marketsLegacyBuckets\\\":\\\"FRCR v0 observational sub-index by model or SKU. Below-floor days remain gaps; no conversion between products is applied.\\\",\\\"marketsLegacyTitle\\\":\\\"Daily v0 \u2014 weighted median (planck/Gn)\\\",\\\"poiErrorTitle\\\":\\\"Failed to load PoI data\\\",\\\"poiErrorMessage\\\":\\\"Could not fetch PoI data from the indexer\\\",\\\"poiDirectSubmissionsNote\\\":\\\"This table contains direct PoI submissions only. Channel settlements appear in the other tab.\\\",\\\"miningPoiRiskTitle\\\":\\\"PoI \\u0026 Risk\\\",\\\"miningPoiRank\\\":\\\"PoI Rank\\\",\\\"minerVerifyWorkIntro\\\":\\\"Look up your miner account and inspect settled channels. Direct PoI submissions have a separate view.\\\",\\\"minerPoiWork\\\":\\\"PoI work\\\",\\\"walletAccountSummary\\\":\\\"Balance · inference · HTLCs · PoI proofs\\\",\\\"networkStatsOperators\\\":\\\"Validators / Miners\\\",\\\"networkStatsOperatorsTitle\\\":\\\"Validators in the current session / miners registered and not blacklisted. A registered miner is not necessarily serving: Mining shows gateway availability.\\\",\\\"networkStatsPastTimeout\\\":\\\"{count, number} past timeout\\\",\\\"networkStatsPastTimeoutTitle\\\":\\\"Past the timelock at the indexed best head. The funds stay locked until a refund_htlc call releases them.\\\",\\\"htlcExternalRecipient\\\":\\\"External chain\\\",\\\"analyticsProofSubmitters24h\\\":\\\"PoI Proof Submitters (24h)\\\",\\\"miningAvailabilityChecking\\\":\\\"Checking availability…\\\",\\\"miningMinersError\\\":\\\"Could not load miners\\\",\\\"miningMinersErrorDetail\\\":\\\"The indexer request failed.\\\",\\\"miningFilterSearch\\\":\\\"Search address or GPU\\\",\\\"miningFilterAvailability\\\":\\\"Any availability\\\",\\\"miningFilterRegistration\\\":\\\"Any registration\\\",\\\"miningFilterVersion\\\":\\\"Any version status\\\",\\\"miningFilterClear\\\":\\\"Clear filters\\\",\\\"miningFilterCount\\\":\\\"{shown, number} of {total, number}\\\",\\\"miningFilterNoMatch\\\":\\\"No miners match these filters.\\\",\\\"miningColMiner\\\":\\\"Miner\\\",\\\"miningColSelfStake\\\":\\\"Self\\\",\\\"miningColDelegated\\\":\\\"Delegated\\\",\\\"miningColPledge\\\":\\\"B_p\\\",\\\"miningColPledgeTitle\\\":\\\"Pledge baseline (B_p)\\\",\\\"miningColStrikes\\\":\\\"Strikes\\\",\\\"miningColStatus\\\":\\\"Status\\\",\\\"miningColStatusTitle\\\":\\\"Registration and gateway availability\\\",\\\"miningColVersion\\\":\\\"Version\\\",\\\"miningColActions\\\":\\\"Actions\\\",\\\"miningCopyAddress\\\":\\\"Copy address\\\",\\\"miningAddressCopied\\\":\\\"Address copied\\\",\\\"miningViewAccount\\\":\\\"View account\\\"},\\\"now\\\":\\\"$undefined\\\",\\\"timeZone\\\":\\\"UTC\\\",\\\"children\\\":\\\"$L1b\\\"}]\\n1c:I[442618,[\\\"$4\\\",\\\"$5\\\",\\\"$6\\\",\\\"$7\\\",\\\"$8\\\",\\\"$9\\\",\\\"$a\\\"],\\\"Providers\\\"]\\n1d:I[603374,[\\\"$4\\\",\\\"$5\\\",\\\"$6\\\",\\\"$7\\\",\\\"$8\\\",\\\"$9\\\",\\\"$a\\\"],\\\"Header\\\"]\\n1e:\\\"IndexerSyncNotice\\\"\\n1f:I[929721,[\\\"$4\\\",\\\"$5\\\",\\\"$6\\\",\\\"$7\\\",\\\"$8\\\",\\\"$9\\\",\\\"$a\\\"],\\\"$1e\\\"]\\n20:I[99643,[\\\"$4\\\",\\\"$5\\\",\\\"$6\\\",\\\"$7\\\",\\\"$8\\\",\\\"$9\\\",\\\"$a\\\"],\\\"default\\\"]\\n21:\\\"/_next/static/chunks/3etom5xw4cw5_.js\\\"\\n22:I[758298,[\\\"$4\\\",\\\"$5\\\",\\\"$6\\\",\\\"$7\\\",\\\"$8\\\",\\\"$9\\\",\\\"$a\\\",\\\"$21\\\"],\\\"default\\\"]\\n23:I[252714,[\\\"$4\\\",\\\"$5\\\",\\\"$6\\\",\\\"$7\\\",\\\"$8\\\",\\\"$9\\\",\\\"$a\\\"],\\\"default\\\"]\\n24:I[437392,[\\\"$4\\\",\\\"$5\\\",\\\"$6\\\",\\\"$7\\\",\\\"$8\\\",\\\"$9\\\",\\\"$a\\\"],\\\"default\\\"]\\n25:I[846748,[\\\"$4\\\",\\\"$5\\\",\\\"