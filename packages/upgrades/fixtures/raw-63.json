 [\\\\n@@ -245,8 +248,7 @@ def subsidy_total_rate(era: int) -> Fraction:\\\\n             f\\\\\\\"{mirrors_checked} external mirrors match.\\\\\\\"\\\\n         )\\\\n         print(\\\\n-            \\\\\\\"  derived constants mirrored outside params/, verified against their shipped \\\\\\\"\\\\n-            \\\\\\\"literals:\\\\\\\"\\\\n+            \\\\\\\"  derived constants mirrored outside params/, verified against their shipped literals:\\\\\\\"\\\\n         )\\\\n         print(\\\\n             f\\\\\\\"    total_issued_end_era6 = {int(total_era6):,}\\\\\\\"\\\"},{\\\"sha\\\":\\\"1a1ceb4a9cd82f3b7322fdb306ab3048a23d15e2\\\",\\\"filename\\\":\\\"scripts/check_params.py\\\",\\\"status\\\":\\\"modified\\\",\\\"additions\\\":12,\\\"deletions\\\":2,\\\"changes\\\":14,\\\"blob_url\\\":\\\"https://github.com/flop-labs/yellowpaper/blob/56410c67b11292e707d32ef32e9c4ff9c02e28c7/scripts%2Fcheck_params.py\\\",\\\"raw_url\\\":\\\"https://github.com/flop-labs/yellowpaper/raw/56410c67b11292e707d32ef32e9c4ff9c02e28c7/scripts%2Fcheck_params.py\\\",\\\"contents_url\\\":\\\"https://api.github.com/repos/flop-labs/yellowpaper/contents/scripts%2Fcheck_params.py?ref=56410c67b11292e707d32ef32e9c4ff9c02e28c7\\\",\\\"patch\\\":\\\"@@ -7,7 +7,8 @@\\\\n \\\\n Reads `params/flop-protocol-params.yaml` (the single source of truth) and verifies\\\\n that every enforced parameter's `expect` snippet is present in each implementation\\\\n-file. Fails (exit 1) if any implementation has drifted from the canonical value.\\\\n+file, ignoring whitespace between tokens. Fails (exit 1) if any implementation\\\\n+has drifted from the canonical value.\\\\n \\\\n Usage:\\\\n     uv run --script scripts/check_params.py            # check, print report\\\\n@@ -98,6 +99,15 @@ def _underscored(value) -> str:\\\\n     return str(value)\\\\n \\\\n \\\\n+def _count_snippet(text: str, expect: str) -> int:\\\\n+    \\\\\\\"\\\\\\\"\\\\\\\"Count non-overlapping snippets, allowing whitespace between whole tokens.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n+    pattern = r\\\\\\\"\\\\\\\\s*\\\\\\\".join(\\\\n+        rf\\\\\\\"\\\\\\\\b{re.escape(token)}\\\\\\\\b\\\\\\\" if re.fullmatch(r\\\\\\\"\\\\\\\\w+\\\\\\\", token) else re.escape(token)\\\\n+        for token in re.findall(r\\\\\\\"\\\\\\\\w+|[^\\\\\\\\w\\\\\\\\s]\\\\\\\", expect)\\\\n+    )\\\\n+    return len(re.findall(pattern, text))\\\\n+\\\\n+\\\\n def main() -> int:\\\\n     quiet = \\\\\\\"--quiet\\\\\\\" in sys.argv\\\\n     spec = yaml.safe_load(CANON.read_text())\\\\n@@ -131,7 +141,7 @@ def main() -> int:\\\\n                 failures.append(f\\\\\\\"[{name}] missing file: {impl['file']}\\\\\\\")\\\\n                 continue\\\\n             text = fpath.read_text()\\\\n-            n = text.count(expect)\\\\n+            n = _count_snippet(text, expect)\\\\n             if want is not None:\\\\n                 if n != want:\\\\n                     failures.append(\\\"},{\\\"sha\\\":\\\"3a4512780a0747c54c4fc3ec26965b0fc54cebe3\\\",\\\"filename\\\":\\\"scripts/gen_param_table.py\\\",\\\"status\\\":\\\"modified\\\",\\\"additions\\\":37,\\\"deletions\\\":6,\\\"changes\\\":43,\\\"blob_url\\\":\\\"https://github.com/flop-labs/yellowpaper/blob/56410c67b11292e707d32ef32e9c4ff9c02e28c7/scripts%2Fgen_param_table.py\\\",\\\"raw_url\\\":\\\"https://github.com/flop-labs/yellowpaper/raw/56410c67b11292e707d32ef32e9c4ff9c02e28c7/scripts%2Fgen_param_table.py\\\",\\\"contents_url\\\":\\\"https://api.github.com/repos/flop-labs/yellowpaper/contents/scripts%2Fgen_param_table.py?ref=56410c67b11292e707d32ef32e9c4ff9c02e28c7\\\",\\\"patch\\\":\\\"@@ -117,13 +117,38 @@ def _strip_artifacts(text: str) -> str:\\\\n     return \\\\\\\" \\\\\\\".join(text.split()).strip(\\\\\\\" ,;\u00b7-\\\\\\\")\\\\n \\\\n \\\\n+def _sentence_ends(text: str) -> list[int]:\\\\n+    \\\\\\\"\\\\\\\"\\\\\\\"Candidate sentence ends, excluding decimals and common abbreviations.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n+    return [\\\\n+        match.start() + 1\\\\n+        for match in re.finditer(r\\\\\\\"(?<=[a-z0-9)\\\\\\\\]%])\\\\\\\\.\\\\\\\\s+[A-Z]\\\\\\\", text)\\\\n+        if not re.search(r\\\\\\\"\\\\\\\\b(?:i\\\\\\\\.e|e\\\\\\\\.g|vs|cf|etc)\\\\\\\\.$\\\\\\\", text[: match.start() + 1], re.I)\\\\n+    ]\\\\n+\\\\n+\\\\n def _first_sentence(text: str) -> str:\\\\n     text = _strip_artifacts(\\\\\\\" \\\\\\\".join(str(text).split()))\\\\n-    # Cut at the first sentence break, but keep decimals / abbreviations intact.\\\\n-    m = re.search(r\\\\\\\"(?<=[a-z0-9)\\\\\\\\]%])\\\\\\\\.\\\\\\\\s+[A-Z]\\\\\\\", text)\\\\n-    if m:\\\\n-        text = text[: m.start() + 1]\\\\n-    return text\\\\n+    ends = _sentence_ends(text)\\\\n+    return text[: ends[0]] if ends else text\\\\n+\\\\n+\\\\n+def description_errors(doc: str, params: list[dict]) -> list[str]:\\\\n+    \\\\\\\"\\\\\\\"\\\\\\\"Reject description prefixes that stop inside a YAML sentence.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n+    descriptions = {\\\\n+        param[\\\\\\\"name\\\\\\\"]: _cell(_strip_artifacts(param.get(\\\\\\\"description\\\\\\\") or param.get(\\\\\\\"note\\\\\\\") or \\\\\\\"\\\\\\\"))\\\\n+        for param in params\\\\n+    }\\\\n+    errors = []\\\\n+    for line in doc.splitlines():\\\\n+        match = re.match(r'\\\\\\\\| <a id=\\\\\\\"param-([\\\\\\\\w]+)\\\\\\\"></a>', line)\\\\n+        if not match or match.group(1) not in descriptions:\\\\n+            continue\\\\n+        name = match.group(1)\\\\n+        cell = re.split(r\\\\\\\"(?<!\\\\\\\\\\\\\\\\)\\\\\\\\|\\\\\\\", line)[-2].strip()\\\\n+        full = descriptions[name]\\\\n+        if cell != full and full.startswith(cell) and len(cell) not in _sentence_ends(full):\\\\n+            errors.append(f\\\\\\\"{name}: Appendix A description ends mid-sentence: {cell!r}\\\\\\\")\\\\n+    return errors\\\\n \\\\n \\\\n def _section_link(text: str, sections: dict[str, str]) -> str:\\\\n@@ -271,14 +296,20 @@ def main() -> int:\\\\n     block = render()\\\\n     updated = _splice(doc, block)\\\\