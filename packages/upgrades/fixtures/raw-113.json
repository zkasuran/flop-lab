import\\\":\\\"./dist/index.js\\\"}},\\\"scripts\\\":{\\\"test\\\":\\\"node --test tests/*.test.mjs\\\",\\\"build\\\":\\\"tsc\\\",\\\"generate\\\":\\\"node scripts/generate.mjs\\\",\\\"check:generated\\\":\\\"node scripts/generate.mjs --check\\\"},\\\"_npmUser\\\":{\\\"name\\\":\\\"svidyuk\\\",\\\"email\\\":\\\"svidyuk@gmail.com\\\"},\\\"_resolved\\\":\\\"/private/tmp/claude-501/-Users-svidyuk-me-flop-core--claude-worktrees-issue-grooming-triage-cd2a2a/e6f8f9ef-a4b2-4f41-95d7-9737f3556783/scratchpad/npm-bootstrap/tarballs/flop-labs-contracts-0.1.1.tgz\\\",\\\"_integrity\\\":\\\"sha512-7EtdXO6hUxc3Kwk5JUuNbgjjtOlyl9ZuWNRqSEL8nlxWeUgAKjogSMJTeuubYVCtRE9gxZNtDmRHwK2yvgv3sw==\\\",\\\"repository\\\":{\\\"url\\\":\\\"git+https://github.com/flop-labs/flop-core.git\\\",\\\"type\\\":\\\"git\\\",\\\"directory\\\":\\\"sdk/contracts\\\"},\\\"_npmVersion\\\":\\\"11.15.0\\\",\\\"description\\\":\\\"Generated structural contracts for FLOP's public inference HTTP API\\\",\\\"directories\\\":{},\\\"sideEffects\\\":false,\\\"_nodeVersion\\\":\\\"24.16.0\\\",\\\"publishConfig\\\":{\\\"access\\\":\\\"public\\\"},\\\"_hasShrinkwrap\\\":false,\\\"devDependencies\\\":{\\\"ajv\\\":\\\"8.20.0\\\",\\\"yaml\\\":\\\"2.9.1\\\",\\\"typescript\\\":\\\"7.0.2\\\",\\\"@types/node\\\":\\\"26.6.2\\\",\\\"json-schema-to-typescript\\\":\\\"16.0.0\\\"},\\\"_npmOperationalInternal\\\":{\\\"tmp\\\":\\\"tmp/contracts_0.1.1_1793246501597_0.08624144717495652\\\",\\\"host\\\":\\\"s3://npm-registry-packages-npm-production\\\"}}},\\\"time\\\":{\\\"created\\\":\\\"2026-10-29T04:00:46.233Z\\\",\\\"modified\\\":\\\"2026-10-29T05:11:44.428Z\\\",\\\"0.0.0-stage\\\":\\\"2026-10-29T04:00:46.233Z\\\",\\\"0.1.1\\\":\\\"2026-10-29T04:01:41.714Z\\\"},\\\"bugs\\\":{\\\"url\\\":\\\"https://github.com/flop-labs/flop-core/issues\\\"},\\\"license\\\":\\\"MIT OR Apache-2.0\\\",\\\"homepage\\\":\\\"https://github.com/flop-labs/flop-core#readme\\\",\\\"repository\\\":{\\\"url\\\":\\\"git+https://github.com/flop-labs/flop-core.git\\\",\\\"type\\\":\\\"git\\\",\\\"directory\\\":\\\"sdk/contracts\\\"},\\\"description\\\":\\\"Generated structural contracts for FLOP's public inference HTTP API\\\",\\\"maintainers\\\":[{\\\"name\\\":\\\"svidyuk\\\",\\\"email\\\":\\\"svidyuk@gmail.com\\\"}],\\\"readme\\\":\\\"# @flop-labs/contracts\\\\n\\\\nStructural types, JSON Schema exports, and assertion validators for the FLOP\\\\npublic HTTP API. Version 0.1.0 covers `listModels`, `getModel`, and JSON\\\\n`createChatCompletion` payloads and streaming frames from `services/rest-gateway/openapi.yaml`.\\\\n\\\\n```sh\\\\nnpm install @flop-labs/contracts\\\\n```\\\\n\\\\n```ts\\\\nimport { assertModelList, type ModelList } from \\\\\\\"@flop-labs/contracts\\\\\\\";\\\\n\\\\nconst response = await fetch(\\\\\\\"https://api.flop.network/v1/models\\\\\\\");\\\\nconst value: unknown = await response.json();\\\\nassertModelList(value);\\\\nconst models: ModelList = value;\\\\n```\\\\n\\\\nExports: `Model`, `ModelList` (also `ModelListResponse`), `ModelResponse`,\\\\n`ChatCompletionRequest`, `ChatCompletionResponse`, `ChatCompletionChunk`, and\\\\n`ChatCompletionStreamError`; their `assert*` functions\\\\nand `*Schema` objects. Invalid data throws `ContractValidationError`; its message\\\\ncontains the contract name, never the submitted values.\\\\n\\\\nValidation checks structure without coercion, default insertion, or removal of\\\\nfields. Responses allow extensions, including receipt evidence, exactly as the\\\\nsource schemas allow. Validating an envelope does not authenticate its evidence,\\\\nverify a receipt, or establish settlement/finality. Request validation follows\\\\nthe API schema. `ChatCompletionStreamUsage` and `ChatCompletionToolCallFragment`\\\\nalso have types, `assert*` functions and `*Schema` objects. `assertChatCompletionStreamError` covers in-band\\\\nbroker errors (including estimated usage and retry hints), session expiry, and\\\\nreceipt reconciliation failures; it does not validate arbitrary HTTP error bodies.\\\\n\\\\nOpenAPI 3.1 models the SSE wire body as a string and references decoded data schemas\\\\nthrough `x-sse-data-schema`. The literal `[DONE]` is a framing sentinel rather than\\\\na JSON chunk. Structural assertions validate individual frames; `@flop-labs/client`\\\\nadditionally enforces ordering, identity consistency, complete tool-call assembly,\\\\nand terminal behavior.\\\\nEstimated error usage does not become receipt evidence by passing"
