p\\\":\\\"^4.63.5\\\",\\\"vitest\\\":\\\"^4.1.12\\\",\\\"@ton/ton\\\":\\\"16.3.0\\\",\\\"@ton/core\\\":\\\"0.63.1\\\",\\\"@vitest/ui\\\":\\\"^4.1.12\\\",\\\"typescript\\\":\\\"^7.0.2\\\",\\\"@ton/crypto\\\":\\\"3.3.0\\\",\\\"@types/node\\\":\\\"^26.6.2\\\",\\\"@ton/sandbox\\\":\\\"0.45.0\\\",\\\"@types/jsdom\\\":\\\"^30.0.0\\\",\\\"@types/react\\\":\\\"^19.3.0\\\",\\\"@account-kit/infra\\\":\\\"4.88.5\\\",\\\"@polkadot/hw-ledger\\\":\\\"^14.0.3\\\",\\\"@vitest/coverage-v8\\\":\\\"^4.1.12\\\",\\\"@testing-library/dom\\\":\\\"^10.4.2\\\",\\\"@vitejs/plugin-react\\\":\\\"^6.1.1\\\",\\\"@rollup/plugin-terser\\\":\\\"^1.0.0\\\",\\\"@rollup/plugin-replace\\\":\\\"^6.0.3\\\",\\\"@testing-library/react\\\":\\\"^16.3.3\\\",\\\"@ton-community/func-js\\\":\\\"0.11.0\\\",\\\"@rollup/plugin-commonjs\\\":\\\"^29.0.3\\\",\\\"@rollup/plugin-typescript\\\":\\\"^12.3.0\\\",\\\"@testing-library/jest-dom\\\":\\\"^7.0.1\\\",\\\"@rollup/plugin-node-resolve\\\":\\\"^16.0.3\\\",\\\"@polkadot/hw-ledger-transports\\\":\\\"^14.0.3\\\",\\\"@virtuals-protocol/acp-node-v2\\\":\\\"0.1.14\\\"},\\\"peerDependencies\\\":{\\\"react\\\":\\\">=18.0.0\\\",\\\"@ton/ton\\\":\\\"^16.3.0\\\",\\\"@ton/core\\\":\\\"^0.63.1\\\",\\\"@ton/crypto\\\":\\\"^3.3.0\\\",\\\"near-api-js\\\":\\\"*\\\",\\\"@polkadot/hw-ledger\\\":\\\"*\\\",\\\"@walletconnect/modal\\\":\\\"*\\\",\\\"@polkadot/extension-dapp\\\":\\\"*\\\",\\\"@walletconnect/universal-provider\\\":\\\"*\\\"},\\\"peerDependenciesMeta\\\":{\\\"react\\\":{\\\"optional\\\":true},\\\"@ton/ton\\\":{\\\"optional\\\":true},\\\"@ton/core\\\":{\\\"optional\\\":true},\\\"@ton/crypto\\\":{\\\"optional\\\":true},\\\"near-api-js\\\":{\\\"optional\\\":true},\\\"@polkadot/hw-ledger\\\":{\\\"optional\\\":true},\\\"@walletconnect/modal\\\":{\\\"optional\\\":true},\\\"@polkadot/extension-dapp\\\":{\\\"optional\\\":true},\\\"@walletconnect/universal-provider\\\":{\\\"optional\\\":true}},\\\"_npmOperationalInternal\\\":{\\\"tmp\\\":\\\"tmp/sdk_0.4.0_1793246581117_0.7726654375627738\\\",\\\"host\\\":\\\"s3://npm-registry-packages-npm-production\\\"}}},\\\"time\\\":{\\\"created\\\":\\\"2026-10-29T04:00:53.210Z\\\",\\\"modified\\\":\\\"2026-10-29T05:12:30.631Z\\\",\\\"0.0.0-stage\\\":\\\"2026-10-29T04:00:53.210Z\\\",\\\"0.4.0\\\":\\\"2026-10-29T04:03:01.374Z\\\"},\\\"bugs\\\":{\\\"url\\\":\\\"https://github.com/flop-labs/flop-core/issues\\\"},\\\"license\\\":\\\"MIT OR Apache-2.0\\\",\\\"homepage\\\":\\\"https://github.com/flop-labs/flop-core#readme\\\",\\\"keywords\\\":[\\\"flop\\\",\\\"blockchain\\\",\\\"substrate\\\",\\\"htlc\\\",\\\"ai\\\",\\\"tee\\\"],\\\"repository\\\":{\\\"url\\\":\\\"git+https://github.com/flop-labs/flop-core.git\\\",\\\"type\\\":\\\"git\\\",\\\"directory\\\":\\\"sdk/typescript\\\"},\\\"description\\\":\\\"TypeScript SDK for the FLOP Network \u2013 HTLC workflows, PoUI proofs, and account management\\\",\\\"maintainers\\\":[{\\\"name\\\":\\\"svidyuk\\\",\\\"email\\\":\\\"svidyuk@gmail.com\\\"}],\\\"readme\\\":\\\"# @flop-labs/sdk\\\\n\\\\nOrdinary HTLC creation requires a registered EconomicCritical appraisal profile.\\\\nSupply `tee_requirements` / `teeRequirements` as `{profile: {profile_id, version}, model_hash, measurement_hash}` (32-byte hex hashes), or its canonical 100-byte SCALE hex.\\\\nThe runtime checks that the registered profile and immutable commitments match its policy; there is no simulator default.\\\\nFor the examples, set `FLOP_HTLC_TEE_REQUIREMENTS` to that canonical hex from your network's registered profile.\\\\n\\\\nTypeScript SDK for the FLOP Network \u2014 HTLC workflows, PoUI proofs, and account management.\\\\n\\\\n`SUPPORTED_SPEC_VERSIONS` admits exactly `1013000`, `1014000`, `1014001`, `1014002`, `1014003`, `1014004`, `1014005` and `1014006`.\\\\n`SUPPORTED_SPEC_VERSION_RANGE` retains its exported shape as the envelope\\\\n`1013000..1014006`; intermediate versions are not admitted. Qualification covers\\\\nruntime `1013000` at `44a5fedc88614b9a6e8c97605c2ec943faf47d9d`, the\\\\nregistrar runtime `1014000` at `e4f01cc849fa6c768d5c0f9c111dffb450ea4fa9`\\\\n(PR #2726), runtime `1014001` at `de4e2779dbf6f8d25348953ce0992ef8e89756bd`\\\\n(PR #2803), runtime `1014002`, the #2637 devnet hybrid-verifier fast path, and runtime\\\\n`1014003` at `9035450361681a69c6c02c9c53e47351999ef6f8` (PR #3096). Candidate runtime\\\\n`1014004` (1.14.4, PR #3006) has source compatibility coverage for uploader-funded\\\\nqualification. Candidate runtime `1014005` (1.14.5) has source compatibility coverage for the\\\\npreactivation FCU name replacement; this does not qualify physical latency or deployment.\\\\nCandidate runtime `1014006` (1.14.6) has source compatibility coverage for the\\\\npreactivation FCU governed adapter; this does not qualify physical latency or deployment.\\\\nOther versions require separate qualification.\\\\nEvery `FlopClient` connection path checks it. Unsupported runtime upgrades detected\\\\nby polkadot.js metadata events disconnect the API and make subsequent SDK operations\\\\nraise `FlopError` with code `RUNTIME_INCOMPATIBLE`, the qualified versions, and upgrade guidance.\\\\nGenerated clients apply the same exact-version guard; explicit profile constraints can\\\\nnarrow compatibility and require a spec name. Upgrade with `pnpm add @flop-labs/sdk@latest` to a release\\\\nsupporting the chain's runtime; allowlist changes require compatibility validation.\\\\n\\\\n## Installation\\\\n\\\\n```bash\\\\nnpm install @flop-labs/sdk\\\\n```\\\\n\\\\n### Peer Dependencies\\\\n\\\\nReact is optional (only needed if using React hooks):\\\\n\\\\n```bash\\\\nnpm install @flop-labs/sdk react  # Optional: for React integration\\\\n```\\\\n\\\\n## Quick Start\\\\n\\\\n```typescript\\\\nimport { FlopClient, createAgentWallet } from '@flop-labs/sdk';\\\\n\\\\n// Connect to FLOP node\\\\nconst client = new FlopClient({\\\\n  rpcUrl: 'http://127.0.0.1:16111/rpc'\\\\n});\\\\n\\\\n// Check node health\\\\nconst health = await client.health();\\\\nconsole.log('Node healthy:', health);\\\\n\\\\n// Create an agent wallet\\\\nconst wallet = await createAgentWallet(client, {\\\\n  agentId: 'my-agent',\\\\n  dailyLimit: 100,  // FLOP tokens\\\\n});\\\\n\\\\n// Create HTLC for inference purchase\\\\nconst htlc = await client.createHtlc({\\\\n  agent: 'my-agent',\\\\n  task: {\\\\n    model: 'llama-3-8b',\\\\n    prompt: 'Hello, world!',\\\\n    tee_requirements: process.env.FLOP_HTLC_TEE_REQUIREMENTS\\\\n  },\\\\n  rewardAmount: 5.0,\\\\n  timeoutBlocks: 60\\\\n});\\\\n\\\\nconsole.log('HTLC created:', htlc.htlcId);\\\\n\\\\n// Wait for settlement\\\\nconst status = await client.waitForSettlement(htlc.hashLock);\\\\nconsole.log('Settlement:', status);\\\\n```\\\\n\\\\n## API Reference\\\\n\\\\n### FlopClient\\\\n\\\\nMain client for interacting with the FLOP Network.\\\\n\\\\n#### Constructor\\\\n\\\\n```typescript\\\\nnew FlopClient(options?: FlopClientOptions)\\\\n```\\\\n\\\\n**Options:**\\\\n- `rpcUrl` (string, optional): RPC endpoint URL. Default: `http://127.0.0.1:16111/rpc`\\\\n- `wsUrl` (string, optional): WebSocket endpoint for subscriptions\\\\n\\\\n#### Methods\\\\n\\\\n##### `health()`\\\\n\\\\nCheck node health status.\\\\n\\\\n```typescript\\\\nawait client.health();\\\\n// Returns: { isSyncing: boolean, peers: number, shouldHavePeers: boolean }\\\\n```\\\\n\\\\n##### `createHtlc(params)`\\\\n\\\\nCreate a Hash Time Lock Contract for atomic inference purchase.\\\\n\\\\n```typescript\\\\nawait client.createHtlc({\\\\n  agent: string,\\\\n  task: ComputeTask,\\\\n  rewardAmount: number,\\\\n  timeoutBlocks: number,\\\\n  hashLock?: string  // Auto-generated if not provided\\\\n});\\\\n```\\\\n\\\\n**Returns:**\\\\n```typescript\\\\n{\\\\n  htlcId: string;\\\\n  hashLock: string;\\\\n  preImage: string;\\\\n  status: 'CREATED';\\\\n}\\\\n```\\\\n\\\\n##### `createCrossChainHtlc(params)`\\\\n\\\\nCreate a cross-chain HTLC for a FLOP \u2194 BTC atomic swap (bilateral HTLC path). The\\\\nFLOP leg must outlive the counter-chain leg (timelock symmetry, enforced on-chain),\\\\nso `timeoutBlocks` is the longer leg and `btcTimelockHours` the shorter. USDT on\\\\nTON/TRON settles via NEAR Intents instead \u2014 see `docs/bridge/settlement.md`.\\\\n\\\\n```typescript\\\\nawait client.createCrossChainHtlc({\\\\n  agent: string,\\\\n  task: ComputeTask,\\\\n  rewardFlop: number,\\\\n  btcAddress: string,\\\\n  btcAmountSats: number | bigint,\\\\n  timeoutBlocks?: number,    // FLOP side, default 7200 (~2h)\\\\n  btcTimelockHours?: number, // counter-chain side, default 1\\\\n  hashLock?: string          // auto-generated if omitted\\\\n});\\\\n```\\\\n\\\\n##### `checkHtlcStatus(hashLock)`\\\\n\\\\nQuery HTLC status by hash lock.\\\\n\\\\n```typescript\\\\nawait client.checkHtlcStatus('0x...');\\\\n// Returns: { status: string, agent: string, rewardAmount: number, timeoutBlock: number }\\\\n```\\\\n\\\\n##### `waitForSettlement(hashLock, timeoutSeconds?, pollInterval?)`\\\\n\\\\nPoll HTLC until settled or timeout.\\\\n\\\\n```typescript\\\\nawait client.waitForSettlement('0x...', 30, 1.0);\\\\n// Returns: { status: 'SETTLED', miner: string, gnUsed: number } | null\\\\n```\\\\n\\\\n##### `getBalance(address)`\\\\n\\\\nGet account balance in FLOP tokens.\\\\n\\\\n```typescript\\\\nawait client.getBalance('flop1qyq...');\\\\n// Returns: number\\\\n```\\\\n\\\\n##### `submitPoUI(proofs, gnWeight, taskHash)`\\\\n\\\\nSubmit TEE-verified PoUI proof batch.\\\\n\\\\n```typescript\\\\nawait client.submitPoUI(proofs, 1450, '0x...');\\\\n```\\\\n\\\\n##### `getAccountInfo(address)`\\\\n\\\\nGet account information including nonce and metadata.\\\\n\\\\n```typescript\\\\nawait client.getAccountInfo('flop1qyq...');\\\\n```\\\\n\\\\n##### `getComputeTask(taskId)`\\\\n\\\\nGet compute task details.\\\\n\\\\n```typescript\\\\nawait client.getComputeTask('task_0x...');\\\\n```\\\\n\\\\n##### `getTeeQuote(task)`\\\\n\\\\nGet TEE quote for compute task.\\\\n\\\\n```typescript\\\\nawait client.getTeeQuote({ model: 'llama-3-8b', prompt: '...' });\\\\n```\\\\n\\\\n### Agent Wallet\\\\n\\\\nCreate and manage agent wallets with session keys.\\\\n\\\\n#### `createAgentWallet(client, options)`\\\\n\\\\nCreate a new agent wallet.\\\\n\\\\n```typescript\\\\nimport { createAgentWallet } from '@flop-labs/sdk';\\\\n\\\\nconst wallet = await createAgentWallet(client, {\\\\n  agentId: 'my-agent',\\\\n  dailyLimit: 100,\\\\n  allowedPallets: ['htlc', 'poui']\\\\n});\\\\n```\\\\n\\\\n#### `fundAgentWallet(client, walletAddress, amount)`\\\\n\\\\nFund an agent wallet from owner account.\\\\n\\\\n```typescript\\\\nimport { fundAgentWallet } from '@flop-labs/sdk';\\\\n\\\\nawait fundAgentWallet(client, 'flop1agent...', 50.0);\\\\n```\\\\n\\\\n#### `agentTransfer(client, fromWallet, toAddress, amount)`\\\\n\\\\nTransfer funds between agent wallets.\\\\n\\\\n```typescript\\\\nimport { agentTransfer } from '@flop-labs/sdk';\\\\n\\\\nawait agentTransfer(client, 'flop1agent1...', 'flop1agent2...', 10.0);\\\\n```\\\\n\\\\n#### `ownerWithdraw(client, walletAddress, amount)`\\\\n\\\\nWithdraw funds from agent wallet to owner account.\\\\n\\\\n```typescript\\\\nimport { ownerWithdraw } from '@flop-labs/sdk';\\\\n\\\\nawait ownerWithdraw(client, 'flop1agent...', 25.0);\\\\n```\\\\n\\\\n#### `createSession(client, walletAddress, options)`\\\\n\\\\nCreate a session key with spending limits.\\\\n\\\\n```typescript\\\\nimport { createSession } from '@flop-labs/sdk';\\\\n\\\\nconst session = await createSession(client, 'flop1agent...', {\\\\n  spendingLimit: 10.0,\\\\n  expiresAt: Date.now() + 3600000  // 1 hour\\\\n});\\\\n```\\\\n\\\\n#### `executeViaSession(client, sessionKey, call)`\\\\n\\\\nExecute a call using session key.\\\\n\\\\n```typescript\\\\nimport { executeViaSession } from '@flop-labs/sdk';\\\\n\\\\nawait executeViaSession(client, sessionKey, {\\\\n  pallet: 'htlc',\\\\n  method: 'create',\\\\n  args: { ... }\\\\n});\\\\n```\\\\n\\\\n### x402 Payment Protocol\\\\n\\\\nUtilities for x402 payment headers.\\\\n\\\\n#### `x402Fetch(url, options, paymentParams)`\\\\n\\\\nFetch with x402 payment headers.\\\\n\\\\n```typescript\\\\nimport { x402Fetch } from '@flop-labs/sdk';\\\\n\\\\nconst response = await x402Fetch('https://api.example.com/inference', {\\\\n  method: 'POST',\\\\n  body: JSON.stringify({ prompt: '...' })\\\\n}, {\\\\n  amount: 5.0,\\\\n  recipient: 'flop1qyq...'\\\\n});\\\\n```\\\\n\\\\n#### `parsePaymentHeaders(headers)`\\\\n\\\\nParse x402 payment headers from response.\\\\n\\\\n```typescript\\\\nimport { parsePaymentHeaders } from '@flop-labs/sdk';\\\\n\\\\nconst payment = parsePaymentHeaders(response.headers);\\\\n```\\\\n\\\\n### Named-miner sessions\\\\n\\\\n`runDirectSession({ api, signer, miner, model, endpoint, prompt, maxFlop, maxTokens })`\\\\nopens a channel on the named miner, verifies its identity and signed response, and\\\\nsettles or recovers escrow. `maxFlop` is raw chain units; `maxTokens` is a positive\\\\nsafe integer and defaults to 256 completion tokens. The request carries that limit\\\\nin the chat envelope bound by the verified receipt. Inspect `receipts[0].finishReason` and\\\\n`completionTokens` for truncation. The 60-second turn deadline remains in force;\\\\nlarger token budgets do not extend it. Settlement separately waits for the channel's\\\\nfinalized calibration allowance before submitting payment. Cooperative delivery and\\\\nfinalized-event discovery share a 60-second deadline; expired channels use timeout recovery.\\\\n\\\\n### Session Estimation (compute channel)\\\\n\\\\nSize a compute-channel session before opening it, entirely off chain, using the chain's own meter:\\\\n\\\\n- `computeChannel.estimateSession` turns a turn profile into `G_n`, minimum blocks, channel count and escrow.\\\\n- `computeChannel.sessionPrior` returns P50/P90/P99 profiles for a task you have not run yet.\\\\n- `computeChannel.calibrateSessionPrior` fits that prior to your model and agent configuration from about 10 probe runs.\\\\n- `computeChannel.reforecastSession` updates the quantiles mid-run.\\\\n\\\\nSee the [session estimation guide](https://github.com/flop-labs/flop-core/blob/main/docs/sdk/session-estimation.md).\\\\n\\\\n### React Hooks (Optional)\\\\n\\\\n```typescript\\\\nimport { useFlopClient, useWalletBalance, useHtlcStatus } from '@flop-labs/sdk/react';\\\\n\\\\nfunction MyComponent() {\\\\n  const client = useFlopClient('http://127.0.0.1:16111/rpc');\\\\n  const { balance } = useWalletBalance(client, 'flop1qyq...');\\\\n  const { status } = useHtlcStatus(client, '0x...');\\\\n  \\\\n  return <div>Balance: {balance} FLOP</div>;\\\\n}\\\\n```\\\\n\\\\n## Types\\\\n\\\\n```typescript\\\\ninterface ComputeTask {\\\\n  model: string;\\\\n  prompt: string;\\\\n  maxTokens?: number;\\\\n  temperature?: number;\\\\n}\\\\n\\\\ninterface HtlcInfo {\\\\n  htlcId: string;\\\\n  hashLock: string;\\\\n  rewardAmount: number;\\\\n  timeoutBlock: number;\\\\n  status: 'CREATED' | 'SETTLED' | 'REFUNDED';\\\\n}\\\\n\\\\ninterface PoUISubmission {\\\\n  proofHash: string;\\\\n  gnMeasured: number;\\\\n  teeQuote: string;\\\\n  timestamp: number;\\\\n}\\\\n\\\\ninterface WalletInfo {\\\\n  address: string;\\\\n  balance: number;\\\\n  dailyLimit: number;\\\\n  dailySpent: number;\\\\n  allowedPallets: string[];\\\\n}\\\\n```\\\\n\\\\n## Error Handling\\\\n\\\\n```typescript\\\\nimport { FlopClient } from '@flop-labs/sdk';\\\\n\\\\nconst client = new FlopClient();\\\\n\\\\ntry {\\\\n  await client.createHtlc({ ... });\\\\n} catch (error) {\\\\n  if (error.code === 'INSUFFICIENT_BALANCE') {\\\\n    console.error('Not enough FLOP tokens');\\\\n  } else if (error.code === 'HTLC_NOT_FOUND') {\\\\n    console.error('Invalid hash lock');\\\\n  } else {\\\\n    console.error('RPC error:', error.message);\\\\n  }\\\\n}\\\\n```\\\\n\\\\n## Complete Example\\\\n\\\\n```typescript\\\\nimport { FlopClient, createAgentWallet, generateHtlcSecrets } from '@flop-labs/sdk';\\\\n\\\\nasync function main() {\\\\n  // Connect to FLOP node\\\\n  const client = new FlopClient({\\\\n    rpcUrl: 'http://127.0.0.1:16111/rpc'\\\\n  });\\\\n\\\\n  // Check connection\\\\n  const health = await client.health();\\\\n  if (!health.isSyncing) {\\\\n    console.log('\u2713 Node is healthy');\\\\n  }\\\\n\\\\n  // Create agent wallet\\\\n  const wallet = await createAgentWallet(client, {\\\\n    agentId: 'trading-agent-01',\\\\n    dailyLimit: 100,\\\\n    allowedPallets: ['htlc', 'poui']\\\\n  });\\\\n  console.log('\u2713 Agent wallet created:', wallet.address);\\\\n\\\\n  // Fund wallet\\\\n  await fundAgentWallet(client, wallet.address, 50.0);\\\\n  console.log('\u2713 Wallet funded with 50 FLOP');\\\\n\\\\n  // Generate HTLC secrets\\\\n  const { preImage, hashLock } = generateHtlcSecrets();\\\\n\\\\n  // Create HTLC for inference\\\\n  const htlc = await client.createHtlc({\\\\n    agent: 'trading-agent-01',\\\\n    task: {\\\\n      model: 'llama-3-8b',\\\\n      prompt: 'Analyze BTC price trend for last 24h',\\\\n      tee_requirements: process.env.FLOP_HTLC_TEE_REQUIREMENTS\\\\n    },\\\\n    rewardAmount: 5.0,\\\\n    timeoutBlocks: 60,\\\\n    hashLock\\\\n  });\\\\n  console.log('\u2713 HTLC created:', htlc.htlcId);\\\\n\\\\n  // Wait for miner to settle\\\\n  console.log('Waiting for settlement...');\\\\n  const settlement = await client.waitForSettlement(hashLock, 30);\\\\n  \\\\n  if (settlement) {\\\\n    console.log('\u2713 Settled by miner:', settlement.miner);\\\\n    console.log('\u2713 Compute used:', settlement.gnUsed, 'G_n');\\\\n  } else {\\\\n    console.log('\u26a0 Timeout - funds refunded');\\\\n  }\\\\n}\\\\n\\\\nmain().catch(console.error);\\\\n```\\\\n\\\\n## Development\\\\n\\\\n```bash\\\\n# Install dependencies\\\\nnpm install\\\\n\\\\n# Build the SDK\\\\nnpm run build\\\\n\\\\n# Watch mode\\\\nnpm run dev\\\\n\\\\n# Clean build artifacts\\\\nnpm clean\\\\n```\\\\n\\\\n## License\\\\n\\\\nApache-2.0 \u00a9 FLOP Network\\\\n\\\\n## NVIDIA GPU Operators\\\\n\\\\nFor miners operating NVIDIA GPUs to earn rewards, see the complete guide:\\\\n\\\\n- **[Run a FLOP miner on a GPU host](https://ask.flop.finance/docs/run-miner)** - Mining setup and workflows\\\\n- [Put your GPU to work on FLOP](https://ask.flop.finance/docs/run-gpu-provider) - Plain-language start for GPU owners new to crypto\\\\n\\\\nQuick example for GPU operators:\\\\n\\\\n```typescript\\\\nimport { FlopClient, type TeeQuote } from '@flop-labs/sdk';\\\\n\\\\n// Connect as miner\\\\nconst client = await FlopClient.create({ \\\\n  endpoint: 'ws://127.0.0.1:9944',\\\\n  signer: '//Miner'\\\\n});\\\\n\\\\n// Monitor for HTLCs\\\\nconst htlc = await client.checkHtlcStatus(hashLock);\\\\nif (htlc && htlc.status === 'CREATED') {\\\\n  // Execute inference on NVIDIA GPU\\\\n  const result = await executeOnGpu(htlc.task); // Your GPU execution logic\\\\n  \\\\n  // Generate TEE quote\\\\n  const teeQuote: TeeQuote = {\\\\n    version: '1.0',\\\\n    miner_address: client.address,\\\\n    task_reference: {\\\\n      htlc_hash_lock: htlc.hashLock,\\\\n      model_hash: `sha256:${htlc.task.model}`,\\\\n      task_timestamp: Math.floor(Date.now() / 1000),\\\\n    },\\\\n    compute_output: {\\\\n      gn_weight: result.gnWeight,  // G_n weight (BFLOPs)\\\\n      execution_time_ms: result.executionTime,\\\\n      encrypted_result: result.encryptedOutput,\\\\n    },\\\\n    attestation: {\\\\n      tee_type: 'NVIDIA_HOPPER_CC',  // or 'NVIDIA_RUBIN_CC', 'CPU_WRAPPED_TEE'\\\\n      hardware_pubkey: hardwarePubkey,\\\\n      quote_hex: teeQuoteHex,\\\\n      signature: minerSignature,\\\\n    },\\\\n  };\\\\n  \\\\n  // Redeem HTLC with TEE quote\\\\n  const txHash = await client.redeemHtlc(\\\\n    htlc.htlcId,\\\\n    preImage,\\\\n    teeQuote,\\\\n  );\\\\n  console.log('\u2713 HTLC redeemed:', txHash);\\\\n  \\\\n  // Submit PoUI proof batch (optional, for additional rewards)\\\\n  const proofs = generateStarkProofs(result);\\\\n  const taskHash = generateTaskHash(htlc);\\\\n  const proofTxHash = await client.submitPoUI(proofs, result.gnWeight, taskHash);\\\\n  console.log('\u2713 PoUI proof submitted:', proofTxHash);\\\\n}\\\\n```\\\\n\\\\n### TEE Quote Format\\\\n\\\\n```typescript\\\\ninterface TeeQuote {\\\\n  version: string;           // \\\\\\\"1.0\\\\\\\"\\\\n  miner_address: string;     // flop1... address\\\\n  task_reference: {\\\\n    htlc_hash_lock: string;  // HTLC identifier\\\\n    model_hash: string;      // sha256:model...\\\\n    task_timestamp: number;  // Unix timestamp (seconds)\\\\n  };\\\\n  compute_output: {\\\\n    gn_weight: number;       // G_n weight (BFLOPs)\\\\n    execution_time_ms: number;\\\\n    encrypted_result: string; // 0x... encrypted output\\\\n  };\\\\n  attestation: {\\\\n    tee_type: string;        // \\\\\\\"NVIDIA_HOPPER_CC\\\\\\\" | \\\\\\\"NVIDIA_RUBIN_CC\\\\\\\" | \\\\\\\"CPU_WRAPPED_TEE\\\\\\\"\\\\n    hardware_pubkey: string; // 0x... hardware public key\\\\n    quote_hex: string;       // 0x... raw TEE quote\\\\n    signature: string;       // 0x... miner signature\\\\n  };\\\\n}\\\\n```\\\\n\\\\n### Supported TEE Types\\\\n\\\\n| TEE Type | Hardware | Production Ready |\\\\n|----------|----------|------------------|\\\\n| `NVIDIA_HOPPER_CC` | H100, H200 | \u2705 Yes |\\\\n| `NVIDIA_RUBIN_CC` | B100, B200 | \u2705 Yes |\\\\n| `CPU_WRAPPED_TEE` | RTX 4090+ + AMD SEV/Intel TDX | \u26a0\ufe0f Testnet only |\\\\n\\\\n### TEE Verification\\\\n\\\\nThe TEE bridge validates quotes with:\\\\n\\\\n- **Timestamp freshness:** Quotes must be < 60 seconds old\\\\n- **Signature verification:** Validates miner signature\\\\n- **Replay protection:** Tracks task hashes to prevent double-spending\\\\n- **Hardware verification:** Checks hardware keys against registry (production only)\\\\n\\\\n```typescript\\\\nimport { verifyTeeQuote, type PouiPayload } from '@flop-labs/sdk/tee';\\\\n\\\\nconst bridge = new TeeBridge({ simulatorMode: false });\\\\n\\\\n// Register known hardware keys (production)\\\\nbridge.registerHardwareKey('0x...');\\\\n\\\\n// Verify TEE quote\\\\nconst payload: PouiPayload = parseTeeQuote(quoteJson);\\\\nconst result = await bridge.verify(payload);\\\\n\\\\nif (result.valid) {\\\\n  console.log(`\u2713 TEE verified: ${result.gnWeight} G_n`);\\\\n} else {\\\\n  console.error(`\u2717 Verification failed: ${result.error}`);\\\\n}\\\\n```\\\\n\\\\nFor complete setup instructions, hardware requirements, and production deployment guide:\\\\n\\\\n- **[Run a FLOP miner on a GPU host](https://ask.flop.finance/docs/run-miner)** - Production setup and workflows\\\\n- **[Put your GPU to work on FLOP](https://ask.flop.finance/docs/run-gpu-provider)** - Plain-language start for GPU owners: hardware, account, deposit, access\\\\n\\\\n## Links\\\\n\\\\n- [FLOP documentation](https://ask.flop.finance/docs/what-is-flop)\\\\n- [Operator configuration and RPC reference](https://ask.flop.finance/docs/operator-config-reference)\\\\n- [Agent accounts and spend control](https://ask.flop.finance/docs/agent-accounts-and-spend-control)\\\\n\\\",\\\"readmeFilename\\\":\\\"README.md\\\"}\",\"lastModified\":\"Thu, 29 Oct 2026 05:12:32 GMT\"},{\"source\":\"https://registry.npmjs.org/@flop-labs/cli\",\"status\":200,\"measuredAt\":\"2026-11-06T03:27:31.418Z\",\"body\":\"{\\\"_id\\\":\\\"@flop-labs/cli\\\",\\\"_rev\\\":\\\"3-e9d6729cbf5d4ce049a278663190359e\\\",\\\"name\\\":\\\"@flop-labs/cli\\\",\\\"dist-tags\\\":{\\\"latest\\\":\\\"0.4.0\\\"},\\\"versions\\\":{\\\"0.0.0-stage\\\":{\\\"name\\\":\\\"@flop-labs/cli\\\",\\\"version\\\":\\\"0.0.0-stage\\\",\\\"_id\\\":\\\"@flop-labs/cli@0.0.0-stage\\\",\\\"stub\\\":true,\\\"maintainers\\\":[{\\\"name\\\":\\\"svidyuk\\\",\\\"email\\\":\\\"svidyuk@gmail.com\\\"}],\\\"dist\\\":{\\\"shasum\\\":\\\"cb893f2277afa5446a53c292b8e57a6fd87b64c5\\\",\\\"tarball\\\":\\\"https://registry.npmjs.org/@flop-labs/cli/-/cli-0.0.0-stage.tgz\\\",\\\"fileCount\\\":2,\\\"integrity\\\":\\\"sha512-7Peg/zjdpccOsqGK3Meexr+6gsepQnQZJE4gZSt3DwDKS