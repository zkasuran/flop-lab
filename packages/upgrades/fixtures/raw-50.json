cripts/bundle.mjs\\\",\\\"start\\\":\\\"node dist/cli.js\\\",\\\"test:unit\\\":\\\"vitest run tests/unit\\\",\\\"typecheck\\\":\\\"tsc --noEmit\\\",\\\"test:public\\\":\\\"node --test scripts/*.test.mjs\\\",\\\"build:public\\\":\\\"node scripts/build-public.mjs\\\",\\\"verify:public\\\":\\\"node scripts/verify-public.mjs\\\"},\\\"_npmUser\\\":{\\\"name\\\":\\\"svidyuk\\\",\\\"email\\\":\\\"svidyuk@gmail.com\\\"},\\\"_resolved\\\":\\\"/private/tmp/claude-501/-Users-svidyuk-me-flop-core--claude-worktrees-issue-grooming-triage-cd2a2a/e6f8f9ef-a4b2-4f41-95d7-9737f3556783/scratchpad/npm-bootstrap/tarballs/flop-labs-cli-0.4.0.tgz\\\",\\\"_integrity\\\":\\\"sha512-X38hpJKsF/GqLMcLKhiG4QldCSRudEr6Lci5wUK9QyBQ7BuKYNVpBmBdKoQS6R/f9qK8wN9p/ALuAIq5xrSqqg==\\\",\\\"repository\\\":{\\\"url\\\":\\\"git+https://github.com/flop-labs/flop-core.git\\\",\\\"type\\\":\\\"git\\\",\\\"directory\\\":\\\"sdk/cli\\\"},\\\"_npmVersion\\\":\\\"11.15.0\\\",\\\"description\\\":\\\"FLOP Network CLI \u2014 interact with FLOP from the terminal\\\",\\\"directories\\\":{},\\\"_nodeVersion\\\":\\\"24.16.0\\\",\\\"dependencies\\\":{\\\"commander\\\":\\\"^15.0.0\\\",\\\"@polkadot/api\\\":\\\"^17.0.1\\\",\\\"@flop-labs/sdk\\\":\\\"^0.4.0\\\",\\\"@flop-labs/client\\\":\\\"^0.2.1\\\",\\\"@polkadot/keyring\\\":\\\"^14.0.3\\\",\\\"@polkadot/util-crypto\\\":\\\"^14.0.3\\\"},\\\"publishConfig\\\":{\\\"access\\\":\\\"public\\\"},\\\"_hasShrinkwrap\\\":false,\\\"devDependencies\\\":{\\\"tsx\\\":\\\"^4.23.15\\\",\\\"vitest\\\":\\\"^4.1.12\\\",\\\"esbuild\\\":\\\"0.28.2\\\",\\\"typescript\\\":\\\"^7.0.2\\\",\\\"@types/node\\\":\\\"^26.6.2\\\",\\\"@polkadot/types\\\":\\\"^17.0.1\\\",\\\"@flop-labs/agent-sdk\\\":\\\"0.2.0\\\",\\\"@flop-labs/gateway-core\\\":\\\"0.2.0\\\"},\\\"_npmOperationalInternal\\\":{\\\"tmp\\\":\\\"tmp/cli_0.4.0_1793246535562_0.2994485607096383\\\",\\\"host\\\":\\\"s3://npm-registry-packages-npm-production\\\"}}},\\\"time\\\":{\\\"created\\\":\\\"2026-10-29T04:00:59.319Z\\\",\\\"modified\\\":\\\"2026-10-29T05:13:06.599Z\\\",\\\"0.0.0-stage\\\":\\\"2026-10-29T04:00:59.319Z\\\",\\\"0.4.0\\\":\\\"2026-10-29T04:02:15.653Z\\\"},\\\"bugs\\\":{\\\"url\\\":\\\"https://github.com/flop-labs/flop-core/issues\\\"},\\\"license\\\":\\\"MIT OR Apache-2.0\\\",\\\"homepage\\\":\\\"https://github.com/flop-labs/flop-core#readme\\\",\\\"repository\\\":{\\\"url\\\":\\\"git+https://github.com/flop-labs/flop-core.git\\\",\\\"type\\\":\\\"git\\\",\\\"directory\\\":\\\"sdk/cli\\\"},\\\"description\\\":\\\"FLOP Network CLI \u2014 interact with FLOP from the terminal\\\",\\\"maintainers\\\":[{\\\"name\\\":\\\"svidyuk\\\",\\\"email\\\":\\\"svidyuk@gmail.com\\\"}],\\\"readme\\\":\\\"# @flop-labs/cli\\\\n\\\\nFLOP Network CLI \u2014 interact with FLOP Network nodes from the command line.\\\\n\\\\n## Installation\\\\n\\\\nThe full CLI (key, miner, validator and model commands) needs Node.js 22+. Run a pinned release\\\\nfrom public npm without installing it globally:\\\\n\\\\n```bash\\\\nnpx --yes --package @flop-labs/cli@0.4.0 flop --version\\\\n```\\\\n\\\\nOr run the promoted container image, which needs only Docker. For a reproducible digest pin,\\\\nuse [releases.json](https://flop.network/releases.json). The image starts in `/app`, so mount\\\\nyour working directory and pass absolute paths under it:\\\\n\\\\n```bash\\\\ndocker run --rm --network host -v \\\\\\\"$PWD:/work\\\\\\\" \\\\\\\\\\\\n  ghcr.io/flop-labs/"
