"ig\\\":\\\"MEUCIQC2eAYnVRF4+JS3V8kEW/ZGNiRGyzWP96PV+VZ785rfcgIgQfqz/i+rN+s3o7cyGLX7+RYK/wjjDrjXYr029XU9Q10=\\\",\\\"keyid\\\":\\\"SHA256:DhQ8wR5APBvFHLF/+Tc+AYvPOdTpcIDqOhxsBHRwC7U\\\"},{\\\"sig\\\":\\\"MEUCIQDUMFvrMNEcNsthof/NEQk0raGR5GHZwXnbTQBpibDLYgIgUaQ80tlNyfifgUwWDCAEwO0E7jIZfozkdeKAZW1Sffk=\\\",\\\"keyid\\\":\\\"SHA256:DhQ8wR5APBvFHLF/+Tc+AYvPOdTpcIDqOhxsBHRwC7U\\\"}],\\\"unpackedSize\\\":13006178},\\\"main\\\":\\\"dist/index.js\\\",\\\"type\\\":\\\"module\\\",\\\"_from\\\":\\\"file:tarballs/flop-labs-sdk-0.4.0.tgz\\\",\\\"types\\\":\\\"dist/index.d.ts\\\",\\\"browser\\\":\\\"dist/bundle/index.esm.js\\\",\\\"exports\\\":{\\\".\\\":{\\\"types\\\":\\\"./dist/index.d.ts\\\",\\\"import\\\":\\\"./dist/index.js\\\",\\\"require\\\":\\\"./dist/bundle/index.umd.cjs\\\"},\\\"./a2a\\\":{\\\"types\\\":\\\"./dist/a2a/index.d.ts\\\",\\\"import\\\":\\\"./dist/a2a/index.js\\\",\\\"require\\\":\\\"./dist/a2a-cjs/index.js\\\"},\\\"./ton\\\":{\\\"types\\\":\\\"./dist/ton/index.d.ts\\\",\\\"import\\\":\\\"./dist/ton/index.js\\\"},\\\"./react\\\":{\\\"types\\\":\\\"./dist/react/index.d.ts\\\",\\\"import\\\":\\\"./dist/react/index.js\\\"},\\\"./browser\\\":{\\\"import\\\":\\\"./dist/bundle/index.esm.js\\\",\\\"require\\\":\\\"./dist/bundle/index.umd.cjs\\\"},\\\"./experimental\\\":{\\\"types\\\":\\\"./dist/experimental.d.ts\\\",\\\"import\\\":\\\"./dist/experimental.js\\\"},\\\"./experimental/cloudflare\\\":{\\\"types\\\":\\\"./dist/paid-storage/cloudflare.d.ts\\\",\\\"import\\\":\\\"./dist/paid-storage/cloudflare.js\\\"},\\\"./experimental/node-store\\\":{\\\"types\\\":\\\"./dist/paid-storage/node-store.d.ts\\\",\\\"import\\\":\\\"./dist/paid-storage/node-store.js\\\"}},\\\"scripts\\\":{\\\"dev\\\":\\\"tsc --watch\\\",\\\"test\\\":\\\"tsc --noEmit -p tsconfig.type-tests.json && vitest run\\\",\\\"build\\\":\\\"npm run sync:x402-types && tsc && npm run build:a2a-cjs && npm run build:bundle\\\",\\\"clean\\\":\\\"node -e \\\\\\\"require('fs').rmSync('dist', {recursive: true, force