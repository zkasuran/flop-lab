":111287},\\\"type\\\":\\\"module\\\",\\\"_from\\\":\\\"file:tarballs/flop-labs-pi-0.3.1.tgz\\\",\\\"exports\\\":{\\\".\\\":{\\\"types\\\":\\\"./dist/index.d.ts\\\",\\\"import\\\":\\\"./dist/index.js\\\"},\\\"./memory\\\":{\\\"types\\\":\\\"./dist/memory.d.ts\\\",\\\"import\\\":\\\"./dist/memory.js\\\"},\\\"./durable\\\":{\\\"types\\\":\\\"./dist/durable.d.ts\\\",\\\"import\\\":\\\"./dist/durable.js\\\"},\\\"./memory/paid-storage\\\":{\\\"types\\\":\\\"./dist/paid-memory.d.ts\\\",\\\"import\\\":\\\"./dist/paid-memory.js\\\"}},\\\"scripts\\\":{\\\"test\\\":\\\"node --import tsx --test tests/*.test.ts && pnpm test:paid-memory-drill && pnpm test:cloudflare\\\",\\\"build\\\":\\\"tsc -p tsconfig.build.json\\\",\\\"typecheck\\\":\\\"tsc --noEmit && tsc -p tsconfig.cloudflare.json\\\",\\\"dev:cloudflare\\\":\\\"wrangler dev --config examples/cloudflare/wrangler.jsonc\\\",\\\"test:cloudflare\\\":\\\"vitest run --config tests/cloudflare/vitest.config.ts\\\",\\\"build:cloudflare\\\":\\\"wrangler deploy --dry-run --config examples/cloudflare/wrangler.jsonc --outdir .wrangler/cloudflare-build\\\",\\\"test:paid-memory-drill\\\":\\\"node --import tsx --test --experimental-test-isolation=none tests/paid-memory-drill-journal.test.ts tests/paid-memory-drill-put-kill.test.ts tests/paid-memory-drill-recall-kill.test.ts tests/paid-memory-drill-reconciliation.test.ts tests/paid-memory-drill-policy.test.ts\\\"},\\\"_npmUser\\\":{\\\"name\\\":\\\"svidyuk\\\",\\\"email\\\":\\\"svidyuk@gmail.com\\\"},\\\"_resolved\\\":\\\"/private/tmp/claude-501/-Users-svidyuk-me-flop-core--claude-worktrees-issue-grooming-triage-cd2a2a/e6f8f9ef-a4b2-4f41-95d7-9737f3556783/scratchpad/npm-bootstrap/tarballs/flop-labs-pi-0.3.1.tgz\\\",\\\"_integrity\\\":\\\"sha512-dHmbf0XT/rK6SdY4mvxHO3o6H+bvBZssPiIXhHA2VfzEOWroaoTTwgXhpSfRTq57pxrkaZwnBYHGCU1rRImFhg==\\\",\\\"repository\\\":{\\\"url\\\":\\\"git+https://github.com/flop-labs/flop-core.git\\\",\\\"type\\\":\\\"git\\\",\\\"directory\\\":\\\"sdk/pi\\\"},\\\"_npmVersion\\\":\\\"11.15.0\\\",\\\"description\\\":\\\"FLOP verified inference for Pi and Pi Durable, with model routing and replay-safe paid jobs\\\",\\\"directories\\\":{},\\\"_nodeVersion\\\":\\\"24.16.0\\\",\\\"dependencies\\\":{\\\"@flop-labs/sdk\\\":\\\"^0.4.0\\\",\\\"@flop-labs/client\\\":\\\"^0.2.1\\\",\\\"@flop-labs/contracts\\\":\\\"^0.1.1\\\"},\\\"publishConfig\\\":{\\\"access\\\":\\\"public\\\"},\\\"_hasShrinkwrap\\\":false,\\\"devDependencies\\\":{\\\"msw\\\":\\\"3.0.2\\\",\\\"tsx\\\":\\\"^4.23.15\\\",\\\"zod\\\":\\\"4.6.6\\\",\\\"agents\\\":\\\"0.26.0\\\",\\\"vitest\\\":\\\"4.1.12\\\",\\\"wrangler\\\":\\\"4.140.0\\\",\\\"typescript\\\":\\\"^7.0.2\\\",\\\"@types/node\\\":\\\"^26.6.2\\\",\\\"@polkadot/api\\\":\\\"^17.0.1\\\",\\\"@msw/cloudflare\\\":\\\"0.2.0\\\",\\\"@polkadot/types\\\":\\\"^17.0.1\\\",\\\"@polkadot/keyring\\\":\\\"^14.0.3\\\",\\\"@earendil-works/chord\\\":\\\"1.4.0\\\",\\\"@earendil-works/pi-ai\\\":\\\"1.4.0\\\",\\\"@polkadot/util-crypto\\\":\\\"^14.0.3\\\",\\\"@cloudflare/workers-types\\\":\\\"5.20260925.2\\\",\\\"@modelcontextprotocol/sdk\\\":\\\"1.32.0\\\",\\\"@earendil-works/pi-durable\\\":\\\"1.4.0\\\",\\\"@modelcontextprotocol/client\\\":\\\"2.3.1\\\",\\\"@modelcontextprotocol/server\\\":\\\"2.3.0\\\",\\\"@cloudflare/vitest-pool-workers\\\":\\\"0.22.0\\\",\\\"@earendil-works/pi-coding-agent\\\":\\\"1.4.0\\\"},\\\"peerDependencies\\\":{\\\"@earendil-works/pi-ai\\\":\\\">=1.4.0\\\",\\\"@earendil-works/pi-durable\\\":\\\"~1.4.0\\\",\\\"@earendil-works/pi-coding-agent\\\":\\\">=1.4.0\\\"},\\\"peerDependenciesMeta\\\":{\\\"@earendil-works/pi-durable\\\":{\\\"optional\\\":true},\\\"@earendil-works/pi-coding-agent\\\":{\\\"optional\\\":true}},\\\"_npmOperationalInternal\\\":{\\\"tmp\\\":\\\"tmp/pi_0.3.1_1793246512143_0.9533431157721968\\\",\\\"host\\\":\\\"s3://npm-registry-packages-npm-production\\\"}}},\\\"time\\\":{\\\"created\\\":\\\"2026-10-29T04:00:56.285Z\\\",\\\"modified\\\":\\\"2026-10-29T05:12:48.344Z\\\",\\\"0.0.0-stage\\\":\\\"2026-10-29T04:00:56.285Z\\\",\\\"0.3.1\\\":\\\"2026-10-29T04:01:52.222Z\\\"},\\\"bugs\\\":{\\\"url\\\":\\\"https://github.com/flop-labs/flop-core/issues\\\"},\\\"license\\\":\\\"MIT OR Apache-2.0\\\",\\\"homepage\\\":\\\"https://github.com/flop-labs/flop-core#readme\\\",\\\"keywords\\\":[\\\"pi-package\\\",\\\"flop\\\",\\\"verified-inference\\\",\\\"virtual-model\\\"],\\\"repository\\\":{\\\"url\\\":\\\"git+https://github.com/flop-labs/flop-core.git\\\",\\\"type\\\":\\\"git\\\",\\\"directory\\\":\\\"sdk/pi\\\"},\\\"description\\\":\\\"FLOP verified inference for Pi and Pi Durable, with model routing and replay-safe paid jobs\\\",\\\"maintainers\\\":[{\\\"name\\\":\\\"svidyuk\\\",\\\"email\\\":\\\"svidyuk@gmail.com\\\"}],\\\"readme\\\":\\\"# @flop-labs/pi\\\\n\\\\nA [Pi](https://pi.dev) package that adds FLOP verified inference to Pi:\\\\n\\\\n- the `flop` provider, with one model for each offer the FLOP gateway currently lists;\\\\n- the `flop/auto` [virtual model](https://pi.dev/docs/latest/virtual-models), which picks a\\\\n  FLOP model for each request.\\\\n\\\\nThe gateway lists an offer only while an attested, identity-verified, priced, and healthy\\\\ncompute session serves it. Each response is settled through a FLOP compute channel. Pi records\\\\nthe physical model behind every answer, and `/session` breaks cost down per model.\\\\n\\\\nRequires Pi 1.4 or later; the extension refuses to load on an older Pi. Virtual models are\\\\nstill experimental in Pi.\\\\n\\\\nFor applications built on **Pi Durable**, see [DURABLE.md](DURABLE.md): the durable subpath\\\\nexposes a physical-model provider and a native `flop_infer` tool with persistent request IDs\\\\nand receipt metadata, plus a SQLite-backed example and the memory/settlement integration map.\\\\n\\\\n[MEMORY.md](MEMORY.md) describes the experimental memory subpath: native remember/recall\\\\ntools over a host-supplied verified-memory client, with isolated namespaces, durable\\\\noperation records and an encrypted local conformance example. The paid-memory SDK and\\\\nprovider binding remain prerequisites for real FLOP storage.\\\\n\\\\nFor **Cloudflare Workers**, see [CLOUDFLARE.md](CLOUDFLARE.md): Cloudflare's installation\\\\ncommand and a private RPC example using `agents/harness/pi`, Lifecycle SQLite and\\\\nthe native FLOP provider/tool.\\\\n\\\\n## Install\\\\n\\\\nThe package is published to GitHub Packages for now, not npm. Its npm registry needs a GitHub\\\\ntoken with `read:packages` even for public packages, so route the `@flop-labs` scope in your\\\\nuser npm config first; `pi install` reads it:\\\\n\\\\n```bash\\\\nnpm config set @flop-labs:registry https://npm.pkg.github.com\\\\nnpm config set //npm.pkg.github.com/:_authToken \\\\\\\"$(gh auth token)\\\\\\\"  # or a classic token with read:packages\\\\npi install npm:@flop-labs/pi   # add the package to your Pi settings\\\\n```\\\\n\\\\nApplications that import the subpaths (`@flop-labs/pi/durable`, `/memory`,\\\\n`/memory/paid-storage`) install it with `npm install @flop-labs/pi` instead.\\\\n\\\\nFrom a checkout of this repository, build the package first; Pi loads `dist/index.js`:\\\\n\\\\n```bash\\\\npnpm --filter \\\\\\\"@flop-labs/pi...\\\\\\\" run build\\\\npi install ./sdk/pi            # add the package to your Pi settings\\\\npi -e ./sdk/pi/src/index.ts    # or load the source for one run\\\\n```\\\\n\\\\n## Configure\\\\n\\\\n| Variable | Required | Meaning |\\\\n|---|---|---|\\\\n| `FLOP_GATEWAY_URL` | yes | FLOP inference gateway, for example `http://127.0.0.1:3200` for a local stack. Without it the extension fails to load, and Pi reports the error. |\\\\n| `FLOP_API_KEY` | yes | Gateway credential. Without it the FLOP models are unavailable. Use a bounded child credential (`flop_ek_\u2026` from `POST /v1/keys/ephemeral` or `POST /v1/connect/grants`) with a spend cap, rather than an owner key. |\\\\n| `FLOP_PI_FALLBACK_MODEL` | no | `provider/model` that answers after every FLOP model has failed in the current turn, for example `anthropic/claude-sonnet-4-5`. Answers from this model are **not** FLOP-verified. In interactive mode Pi shows a warning when it switches to the fallback. Leave it unset to keep `flop/auto` FLOP-only. |\\\\n\\\\nExample `~/.pi/agent/settings.json` that starts Pi on `flop/auto`:\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"packages\\\\\\\": [\\\\\\\"npm:@flop-labs/pi\\\\\\\"],\\\\n  \\\\\\\"defaultProvider\\\\\\\": \\\\\\\"flop\\\\\\\",\\\\n  \\\\\\\"defaultModel\\\\\\\": \\\\\\\"auto\\\\\\\",\\\\n  \\\\\\\"defaultThinkingLevel\\\\\\\": \\\\\\\"low\\\\\\\"\\\\n}\\\\n```\\\\n\\\\nThe package reads the catalog once, when it loads. Run `/reload` to pick up offers added later.\\\\nDiscovery uses `@flop-labs/client` and the shared public API contracts, with a ten-second deadline\\\\nand redirects disabled. Catalog validation checks the response's structure; Pi retains its\\\\nprice, limit and capability checks. Inference continues through Pi's Anthropic Messages transport.\\\\n\\\\n## How `flop/auto` routes\\\\n\\\\n| Request | Routed to |\\\\n|---|---|\\\\n| New user message | A FLOP model chosen by the thinking level you selected. `low` picks the cheapest model whose context window fits the conversation, `high` the most expensive, and `medium` the one in between. FLOP prices each token by the compute it meters for it, so price order follows model size. |\\\\n| Tool follow-up in the same turn | The model already answering that turn, so its prompt cache stays valid. |\\\\n| Retry after a context overflow | The FLOP model with the largest context window. |\\\\n| Retry after any other failure | The next FLOP model. Failed models are kept as router state on the session branch, so they survive compaction and follow `/tree`. The failure list resets at the next user message. |\\\\n| Every FLOP model failed this turn | `FLOP_PI_FALLBACK_MODEL` if it is set. Otherwise the request fails. |\\\\n\\\\nThe thinking level is also forwarded to the model that was picked, and Pi clamps it to what that\\\\nmodel supports. A model without reasoning runs with thinking off. A reasoning model accepts\\\\n`low`, `medium`, or `high` effort, and a request for `off` runs at `low`, because the gateway\\\\ncannot disable thinking.\\\\n\\\\nA stream that fails before any output is retried. The gateway released that request's\\\\nreservation, so Pi records no cost for the failed attempt. A stream that fails after output has\\\\nbeen committed is not retried, because the gateway already charged for it.\\\\n\\\\n## Task correlation\\\\n\\\\nEach agent run, meaning a prompt together with its tool turns and retries, sends one random\\\\n`X-Correlation-ID` on its FLOP requests. The next prompt gets a new id. The gateway uses the\\\\nid to group a task's turns in its usage labels. The id carries no prompt text, and requests\\\\nrouted to the fallback model do not send it.\\\\n\\\\n## Limits\\\\n\\\\n- **Text only.** The gateway's Messages bridge accepts text and tool blocks, so Pi sends\\\\n  placeholders in place of images.\\\\n- **Every model is FLOP-verified.** All listed models carry the same attestation, so the router\\\\n  has no verification tier to choose between.\\\\n- **Subagents.** `pi-subagents` children can start on `flop/auto` from `pi-subagents` 0.75.0\\\\n  (nicobailon/pi-subagents#2635). With an older release, give them a physical model such as\\\\n  `flop/<model-id>`.\\\\n- **Unknown model at prompt time.** `before_agent_start` handlers see `ctx.model.api === \\\\\\\"pi-virtual\\\\\\\"`\\\\n  and cannot know which physical model will answer (earendil-works/pi#10318).\\\\n\\\\n## Develop\\\\n\\\\n```bash\\\\npnpm --filter @flop-labs/pi typecheck\\\\npnpm --filter @flop-labs/pi test\\\\n```\\\\n\\\\n`tests/gateway-contract.test.ts` sends Pi's real Anthropic request through the gateway's own\\\\nrequest validator (`services/rest-gateway/src/agent-protocol.ts`). A gateway change that rejects\\\\nwhat Pi sends fails this package's tests.\\\\n\\\",\\\"readmeFilename\\\":\\\"README.md\\\"}\",\"lastModified\":\"Thu, 29 Oct 2026 05:12:49 GMT\"},{\"source\":\"https://pypi.org/pypi/flop-sdk/json\",\"status\":200,\"measuredAt\":\"2026-11-06T03:27:32.507Z\",\"body\":\"{\\\"info\\\":{\\\"author\\\":null,\\\"author_email\\\":\\\"FLOP Network <dev@flop.network>\\\",\\\"bugtrack_url\\\":null,\\\"classifiers\\\":[\\\"Development Status :: 3 - Alpha\\\",\\\"Intended Audience :: Developers\\\",\\\"License :: OSI Approved :: Apache Software License\\\",\\\"License :: OSI Approved :: MIT License\\\",\\\"Programming Language :: Python :: 3\\\",\\\"Programming Language :: Python :: 3.10\\\",\\\"Programming Language :: Python :: 3.11\\\",\\\"Programming Language :: Python :: 3.12\\\",\\\"Topic :: Software Development :: Libraries\\\"],\\\"description\\\":\\\"# flop-sdk\\\\n\\\\nOrdinary HTLC creation requires a registered EconomicCritical appraisal profile.\\\\nSupply `tee_requirements` / `teeRequirements` as `{profile: {profile_id, version}, model_hash, measurement_hash}` (32-byte hex hashes), or its canonical 100-byte SCALE hex.\\\\nThe runtime checks that the registered profile and immutable commitments match its policy; there is no simulator default.\\\\nFor the examples, set `FLOP_HTLC_TEE_REQUIREMENTS` to that canonical hex from your network's registered profile.\\\\n\\\\nFLOP Network SDK for Python \u2014 HTLC workflows, PoUI proofs, and account management.\\\\n\\\\n`SUPPORTED_SPEC_VERSIONS` admits exactly `1013000`, `1014000` through `1014005`, and `1014007`\\\\nthrough `1014011`. `SUPPORTED_SPEC_VERSION_RANGE` retains its exported shape as the envelope\\\\n`1013000..1014011`; versions inside it that are not listed, `1014006` among them, are not\\\\nadmitted. Qualification covers\\\\nruntime `1013000` at `44a5fedc88614b9a6e8c97605c2ec943faf47d9d`, the\\\\nregistrar runtime `1014000` at `e4f01cc849fa6c768d5c0f9c111dffb450ea4fa9`\\\\n(PR #2726), runtime `1014001` at `de4e2779dbf6f8d25348953ce0992ef8e89756bd`\\\\n(PR #2803), runtime `1014002`, the #2637 devnet hybrid-verifier fast path, and runtime\\\\n`1014003` at `9035450361681a69c6c02c9c53e47351999ef6f8` (PR #3096). Candidate runtime\\\\n`1014004` (1.14.4, PR #3006) has source compatibility coverage for uploader-funded\\\\nqualification. Candidate runtime `1014005` (1.14.5) has source compatibility coverage for the\\\\npreactivation FCU name replacement. Candidate runtimes `1014007` (1.14.7, integer accounting,\\\\ntransaction version 2) through `1014011` (funding-time FCU economic snapshots) have source\\\\ncompatibility coverage for the preactivation FCU accounting, resale and activation changes.\\\\nSource coverage does not qualify physical latency or deployment.\\\\nOther versions require separate qualification.\\\\n`FlopClient` checks on connect and before each HTTP RPC because HTTP has no\\\\nruntime-upgrade subscription. `SubstrateClient` checks on connect, before metadata\\\\nrefresh/signing, and again before submission, including for cached signed extrinsics.\\\\nAn unsupported runtime raises `FLOPError` with code `RUNTIME_INCOMPATIBLE` and the\\\\nqualified versions. Upgrade with `uv pip install --upgrade flop-sdk` to a release\\\\nthat supports the chain's runtime; allowlist changes require compatibility validation.\\\\n\\\\n## Installation\\\\n\\\\n```bash\\\\npip install flop-sdk\\\\n```\\\\n\\\\n### Development Dependencies\\\\n\\\\n```bash\\\\npip install flop-sdk[dev]\\\\n```\\\\n\\\\n## Quick Start\\\\n\\\\n```python\\\\nimport asyncio\\\\nimport os\\\\nfrom flop_sdk import FlopClient, SubstrateClient, generate_htlc_secrets\\\\n\\\\n\\\\nasync def main():\\\\n    # Connect to FLOP node\\\\n    async with FlopClient() as client:\\\\n        # Check node health\\\\n        health = await client.health()\\\\n        print(f\\\\\\\"Node healthy: {not health.is_syncing}\\\\\\\")\\\\n\\\\n        # Generate HTLC secrets\\\\n        pre_image, hash_lock = generate_htlc_secrets()\\\\n\\\\n        signer = SubstrateClient()\\\\n        htlc_id, tx_hash = signer.create_htlc(\\\\n            agent=\\\\\\\"my-agent\\\\\\\",\\\\n            task={\\\\n                \\\\\\\"model\\\\\\\": \\\\\\\"llama-3-8b\\\\\\\",\\\\n                \\\\\\\"prompt\\\\\\\": \\\\\\\"Hello\\\\\\\",\\\\n                \\\\\\\"tee_requirements\\\\\\\": os.environ[\\\\\\\"FLOP_HTLC_TEE_REQUIREMENTS\\\\\\\"],\\\\n            },\\\\n            hash_lock=hash_lock,\\\\n            reward_amount=5.0,\\\\n            timeout_blocks=60,\\\\n        )\\\\n        signer.close()\\\\n        print(f\\\\\\\"HTLC submitted: {htlc_id}, tx: {tx_hash}\\\\\\\")\\\\n\\\\n        # Query the submitted HTLC\\\\n        status = await client.check_htlc_status(hash_lock)\\\\n        print(f\\\\\\\"HTLC status: {status.status if status else 'not found'}\\\\\\\")\\\\n\\\\n        # Wait for settlement after a signed submission\\\\n        status = await client.wait_for_settlement(hash_lock, timeout_seconds=30)\\\\n\\\\n        if status:\\\\n            print(f\\\\\\\"Settled by: {status.miner}\\\\\\\")\\\\n            print(f\\\\\\\"G_n used: {status.gn_used}\\\\\\\")\\\\n        else:\\\\n            print(\\\\\\\"Timeout - funds refunded\\\\\\\")\\\\n\\\\n\\\\nasyncio.run(main())\\\\n```\\\\n\\\\n## Substrate Client (Signed Transactions)\\\\n\\\\nFor on-chain operations requiring signed transactions, use `SubstrateClient`. It signs locally and submits through `author_submitExtrinsic`; the HTTP `FlopClient` only queries HTLC state.\\\\n\\\\n```python\\\\nimport os\\\\nfrom flop_sdk import SubstrateClient, SubstrateOptions, create_agent_wallet, generate_htlc_secrets\\\\n\\\\n# Initialize with account seed\\\\nclient = SubstrateClient(SubstrateOptions(rpc_url=\\\\\\\"http://127.0.0.1:16111\\\\\\\", seed=\\\\\\\"alice\\\\\\\"))\\\\n\\\\nprint(f\\\\\\\"Account: {client.address}\\\\\\\")\\\\nprint(f\\\\\\\"Balance: {client.get_balance()} FLOP\\\\\\\")\\\\n\\\\n# Create HTLC on-chain\\\\npre_image, hash_lock = generate_htlc_secrets()\\\\nhtlc_id, tx_hash = client.create_htlc(\\\\n    agent=\\\\\\\"my-agent\\\\\\\",\\\\n    task={\\\\n        \\\\\\\"model\\\\\\\": \\\\\\\"llama-3-8b\\\\\\\",\\\\n        \\\\\\\"prompt\\\\\\\": \\\\\\\"Hello\\\\\\\",\\\\n        \\\\\\\"tee_requirements\\\\\\\": os.environ[\\\\\\\"FLOP_HTLC_TEE_REQUIREMENTS\\\\\\\"],\\\\n    },\\\\n    hash_lock=hash_lock,\\\\n    reward_amount=5.0,\\\\n    timeout_blocks=60,\\\\n)\\\\n\\\\nprint(f\\\\\\\"HTLC: {htlc_id}, TX: {tx_hash}\\\\\\\")\\\\n\\\\n# Redeem HTLC (miner side)\\\\ntee_quote = {\\\\\\\"version\\\\\\\": \\\\\\\"1.0\\\\\\\", \\\\\\\"gn_weight\\\\\\\": 1450, \\\\\\\"attestation\\\\\\\": \\\\\\\"deadbeef\\\\\\\"}\\\\ntx_hash = client.redeem_htlc(htlc_id, pre_image, tee_quote)\\\\nprint(f\\\\\\\"Redeemed: {tx_hash}\\\\\\\")\\\\n\\\\nclient.close()\\\\n```\\\\n\\\\n## Agent Wallet & Session Keys\\\\n\\\\n```python\\\\nfrom flop_sdk import (\\\\n    SubstrateClient,\\\\n    create_agent_wallet,\\\\n    fund_agent_wallet,\\\\n    create_session,\\\\n    execute_via_session,\\\\n)\\\\n\\\\nclient = SubstrateClient(seed=\\\\\\\"alice\\\\\\\")\\\\n\\\\n# Create agent wallet with spending limits\\\\nwallet = create_agent_wallet(\\\\n    client,\\\\n    agent_id=\\\\\\\"trading-agent-01\\\\\\\",\\\\n    daily_limit=100.0,\\\\n    allowed_pallets=[\\\\\\\"htlc\\\\\\\", \\\\\\\"poui\\\\\\\"],\\\\n)\\\\n\\\\n# Fund the wallet\\\\ntx_hash = fund_agent_wallet(client, wallet.address, 50.0)\\\\n\\\\n# Create session key for delegated access\\\\nsession = create_session(\\\\n    client,\\\\n    wallet.address,\\\\n    spending_limit=10.0,\\\\n    expires_in_seconds=3600,  # 1 hour\\\\n)\\\\n\\\\n# Execute via session (no need for full key)\\\\ntx_hash = execute_via_session(\\\\n    client,\\\\n    session.session_key,\\\\n    pallet=\\\\\\\"HasStation\\\\\\\",\\\\n    method=\\\\\\\"create_htlc\\\\\\\",\\\\n    args={...},\\\\n)\\\\n```\\\\n\\\\n## API Reference\\\\n\\\\n### FlopClient (Async HTTP)\\\\n\\\\nHigh-level async HTTP client for RPC queries.\\\\n\\\\n```python\\\\nasync with FlopClient(\\\\n    options=FlopClientOptions(\\\\n        rpc_url=\\\\\\\"http://127.0.0.1:16111/rpc\\\\\\\",\\\\n    )\\\\n) as client:\\\\n    # Health check\\\\n    health = await client.health()\\\\n\\\\n    # Get balance\\\\n    balance = await client.get_balance(\\\\\\\"flop1qyq...\\\\\\\")\\\\n\\\\n    # Check HTLC status\\\\n    status = await client.check_htlc_status(hash_lock)\\\\n\\\\n    # Wait for settlement\\\\n    settled = await client.wait_for_settlement(hash_lock, timeout_seconds=30)\\\\n\\\\n    # Get account info\\\\n    info = await client.get_account_info(\\\\\\\"flop1qyq...\\\\\\\")\\\\n\\\\n    # HTLC writes require SubstrateClient (below)\\\\n```\\\\n\\\\n### SubstrateClient (Signed Transactions)\\\\n\\\\nLow-level Substrate client for on-chain operations.\\\\n\\\\n```python\\\\nclient = SubstrateClient(\\\\n    rpc_url=\\\\\\\"http://127.0.0.1:16111\\\\\\\",\\\\n    seed=\\\\\\\"alice\\\\\\\",  # or mnemonic, or //Alice format\\\\n)\\\\n\\\\n# Account info\\\\nprint(f\\\\\\\"Address: {client.address}\\\\\\\")\\\\nprint(f\\\\\\\"Balance: {client.get_balance()} FLOP\\\\\\\")\\\\n\\\\n# HTLC operations\\\\nhtlc_id, tx_hash = client.create_htlc(...)\\\\ntx_hash = client.redeem_htlc(htlc_id, pre_image, tee_quote)\\\\nstatus = client.check_htlc_status(hash_lock)\\\\n\\\\nclient.close()\\\\n```\\\\n\\\\n### Wallet Functions\\\\n\\\\n```python\\\\n# Create agent wallet\\\\nwallet = create_agent_wallet(client, agent_id, daily_limit=100.0)\\\\n\\\\n# Fund wallet\\\\nfund_agent_wallet(client, wallet.address, amount)\\\\n\\\\n# Transfer between wallets\\\\nagent_transfer(client, from_wallet, to_address, amount)\\\\n\\\\n# Withdraw to owner\\\\nowner_withdraw(client, wallet.address, amount)\\\\n\\\\n# Session management\\\\nsession = create_session(client, wallet.address, spending_limit=10.0)\\\\nrevoke_session(client, session.session_key)\\\\nexecute_via_session(client, session.session_key, pallet, method, args)\\\\n```\\\\n\\\\n### Utilities\\\\n\\\\n```python\\\\nfrom flop_sdk import (\\\\n    generate_htlc_secrets,\\\\n    sign_message,\\\\n    format_flop,\\\\n    flop_to_raw,\\\\n    raw_to_flop,\\\\n    format_address,\\\\n    validate_address,\\\\n    generate_agent_id,\\\\n)\\\\n\\\\n# Generate HTLC secrets\\\\npre_image, hash_lock = generate_htlc_secrets()\\\\n\\\\n# Format amounts\\\\nprint(format_flop(5.0))  # \\\\\\\"5.00 FLOP\\\\\\\"\\\\nprint(flop_to_raw(5.0))  # 5000000000000000000\\\\nprint(raw_to_flop(5000000000000000000))  # 5.0\\\\n\\\\n# Address utilities\\\\nprint(format_address(\\\\\\\"flop1qyq...z9a\\\\\\\"))  # \\\\\\\"flop1qyq...z9a\\\\\\\"\\\\nprint(validate_address(\\\\\\\"flop1qyq...\\\\\\\"))  # True\\\\n\\\\n# Generate agent ID\\\\nagent_id = generate_agent_id(\\\\\\\"trader\\\\\\\")  # \\\\\\\"trader_1234567890_abcd1234\\\\\\\"\\\\n```\\\\n\\\\n## Types\\\\n\\\\n```python\\\\nfrom flop_sdk import (\\\\n    HtlcStatus,\\\\n    ComputeTask,\\\\n    HtlcInfo,\\\\n    CreateHtlcResult,\\\\n    HealthResponse,\\\\n    AccountInfo,\\\\n    WalletInfo,\\\\n    SessionInfo,\\\\n)\\\\n\\\\n# HTLC status enum\\\\nstatus = HtlcStatus.CREATED  # or SETTLED, REFUNDED\\\\n\\\\n# Compute task\\\\ntask = ComputeTask(\\\\n    model=\\\\\\\"llama-3-8b\\\\\\\",\\\\n    prompt=\\\\\\\"Hello, world!\\\\\\\",\\\\n    max_tokens=100,\\\\n    temperature=0.7,\\\\n)\\\\n\\\\n# HTLC info\\\\nhtlc = HtlcInfo(\\\\n    htlc_id=\\\\\\\"htlc_abc123\\\\\\\",\\\\n    hash_lock=\\\\\\\"0x...\\\\\\\",\\\\n    status=HtlcStatus.SETTLED,\\\\n    agent=\\\\\\\"my-agent\\\\\\\",\\\\n    reward_amount=5.0,\\\\n    timeout_block=160,\\\\n    miner=\\\\\\\"flop1qyq...\\\\\\\",\\\\n    gn_used=1450.75,\\\\n)\\\\n```\\\\n\\\\n## Error Handling\\\\n\\\\n```python\\\\nimport os\\\\nfrom flop_sdk import SubstrateClient, generate_htlc_secrets\\\\n\\\\nclient = SubstrateClient()\\\\n_, hash_lock = generate_htlc_secrets()\\\\ntry:\\\\n    htlc_id, tx_hash = client.create_htlc(\\\\n        agent=\\\\\\\"my-agent\\\\\\\",\\\\n        task={\\\\n            \\\\\\\"model\\\\\\\": \\\\\\\"llama-3-8b\\\\\\\",\\\\n            \\\\\\\"prompt\\\\\\\": \\\\\\\"Hello\\\\\\\",\\\\n            \\\\\\\"tee_requirements\\\\\\\": os.environ[\\\\\\\"FLOP_HTLC_TEE_REQUIREMENTS\\\\\\\"],\\\\n        },\\\\n        hash_lock=hash_lock,\\\\n        reward_amount=5.0,\\\\n    )\\\\nexcept Exception as e:\\\\n    print(f\\\\\\\"Signed extrinsic submission failed: {e}\\\\\\\")\\\\nfinally:\\\\n    client.close()\\\\n```\\\\n\\\\n## Complete Example\\\\n\\\\n```python\\\\nimport asyncio\\\\nfrom flop_sdk import (\\\\n    FlopClient,\\\\n    SubstrateClient,\\\\n    create_agent_wallet,\\\\n    fund_agent_wallet,\\\\n    generate_htlc_secrets,\\\\n)\\\\n\\\\n\\\\nasync def main():\\\\n    # Async client for queries\\\\n    async with FlopClient() as rpc_client:\\\\n        # Check node health\\\\n        health = await rpc_client.health()\\\\n        print(f\\\\\\\"\u2713 Node synced: {not health.is_syncing}\\\\\\\")\\\\n\\\\n    # Substrate client for transactions\\\\n    client = SubstrateClient(rpc_url=\\\\\\\"http://127.0.0.1:16111\\\\\\\", seed=\\\\\\\"alice\\\\\\\")\\\\n\\\\n    print(f\\\\\\\"\u2713 Connected: {client.address}\\\\\\\")\\\\n    print(f\\\\\\\"\u2713 Balance: {client.get_balance()} FLOP\\\\\\\")\\\\n\\\\n    # Create agent wallet\\\\n    wallet = create_agent_wallet(\\\\n        client,\\\\n        agent_id=\\\\\\\"trading-agent-01\\\\\\\",\\\\n        daily_limit=100.0,\\\\n    )\\\\n    print(f\\\\\\\"\u2713 Wallet created: {wallet.address}\\\\\\\")\\\\n\\\\n    # Fund wallet\\\\n    fund_agent_wallet(client, wallet.address, 50.0)\\\\n    print(f\\\\\\\"\u2713 Wallet funded\\\\\\\")\\\\n\\\\n    # Generate HTLC secrets\\\\n    pre_image, hash_lock = generate_htlc_secrets()\\\\n\\\\n    # Create HTLC on-chain\\\\n    htlc_id, tx_hash = client.create_htlc(\\\\n        agent=\\\\\\\"trading-agent-01\\\\\\\",\\\\n        task={\\\\\\\"model\\\\\\\": \\\\\\\"llama-3-8b\\\\\\\", \\\\\\\"prompt\\\\\\\": \\\\\\\"Analyze BTC trend\\\\\\\"},\\\\n        hash_lock=hash_lock,\\\\n        reward_amount=5.0,\\\\n        timeout_blocks=60,\\\\n    )\\\\n    print(f\\\\\\\"\u2713 HTLC created: {htlc_id}\\\\\\\")\\\\n    print(f\\\\\\\"\u2713 Transaction: {tx_hash}\\\\\\\")\\\\n\\\\n    # Check status\\\\n    status = client.check_htlc_status(hash_lock)\\\\n    print(f\\\\\\\"\u2713 Status: {status['status']}\\\\\\\")\\\\n\\\\n    client.close()\\\\n\\\\n\\\\nif __name__ == \\\\\\\"__main__\\\\\\\":\\\\n    asyncio.run(main())\\\\n```\\\\n\\\\n## Development\\\\n\\\\n```bash\\\\n# Install development dependencies\\\\npip install -e \\\\\\\".[dev]\\\\\\\"\\\\n\\\\n# Run tests\\\\npytest\\\\n\\\\n# Run tests with coverage\\\\npytest --cov=src/\\\\n\\\\n# Format code\\\\nblack src/ tests/\\\\nruff check --fix src/ tests/\\\\n\\\\n# Type checking\\\\nmypy src/\\\\n\\\\n# Run all checks\\\\nruff format --check . && ruff check . && ty check src examples && pytest\\\\n```\\\\n\\\\n## Requirements\\\\n\\\\n- Python 3.10+\\\\n- aiohttp>=3.9.0 (async HTTP)\\\\n- substrate-interface>=1.0.0 (Substrate RPC)\\\\n- pydantic>=2.0.0 (data validation)\\\\n\\\\n## NVIDIA GPU Operators\\\\n\\\\nFor miners operating NVIDIA GPUs to earn rewards, see the complete guide:\\\\n\\\\n- **[NVIDIA GPU Operator SDK Guide](../../docs/NVIDIA_GPU_OPERATOR_SDK.md)** - Complete SDK guide for NVIDIA H100/H200/Blackwell with TEE attestation\\\\n- [Miner Guide](../../docs/MINER_GUIDE.md) - General mining setup and workflows\\\\n\\\\nQuick example for GPU operators:\\\\n\\\\n```python\\\\nfrom flop_sdk import SubstrateClient\\\\nfrom flop_sdk.tee import NvidiaTeeBridge, generate_tee_quote\\\\n\\\\n# Initialize miner client\\\\nclient = SubstrateClient(rpc_url=\\\\\\\"http://127.0.0.1:16111\\\\\\\", seed=\\\\\\\"//Miner\\\\\\\")\\\\ntee_bridge = NvidiaTeeBridge(simulator_mode=True)  # Set False for production\\\\n\\\\n# Monitor for HTLCs\\\\nhtlc = client.check_htlc_status(hash_lock)\\\\nif htlc and htlc.status == \\\\\\\"CREATED\\\\\\\":\\\\n    # Execute inference on NVIDIA GPU\\\\n    result = execute_on_gpu(htlc.task)  # Your GPU execution logic\\\\n    \\\\n    # Generate TEE quote\\\\n    tee_quote = generate_tee_quote(\\\\n        miner_address=client.address,\\\\n        htlc_hash_lock=htlc.hash_lock,\\\\n        model_hash=htlc.task[\\\\\\\"model\\\\\\\"],\\\\n        gn_weight=result.gn_weight,\\\\n        tee_type=\\\\\\\"NVIDIA_HOPPER_CC\\\\\\\",  # or \\\\\\\"NVIDIA_RUBIN_CC\\\\\\\", \\\\\\\"CPU_WRAPPED_TEE\\\\\\\"\\\\n    )\\\\n    \\\\n    # Redeem HTLC with TEE quote\\\\n    tx_hash = client.redeem_htlc(\\\\n        htlc_id=htlc.htlc_id,\\\\n        pre_image=pre_image,\\\\n        tee_quote=tee_quote,\\\\n    )\\\\n    print(f\\\\\\\"\u2713 HTLC redeemed: {tx_hash}\\\\\\\")\\\\n    \\\\n    # Submit PoUI proof batch (optional, for additional rewards)\\\\n    proofs = generate_stark_proofs(result)\\\\n    task_hash = generate_task_hash(htlc)\\\\n    tx_hash = client.submit_poui(proofs, result.gn_weight, task_hash)\\\\n    print(f\\\\\\\"\u2713 PoUI proof submitted: {tx_hash}\\\\\\\")\\\\n```\\\\n\\\\n### TEE Quote Format\\\\n\\\\n```python\\\\ntee_quote = {\\\\n    \\\\\\\"version\\\\\\\": \\\\\\\"1.0\\\\\\\",\\\\n    \\\\\\\"miner_address\\\\\\\": \\\\\\\"flop1...\\\\\\\",\\\\n    \\\\\\\"task_reference\\\\\\\": {\\\\n        \\\\\\\"htlc_hash_lock\\\\\\\": \\\\\\\"0x...\\\\\\\",\\\\n        \\\\\\\"model_hash\\\\\\\": \\\\\\\"sha256:...\\\\\\\",\\\\n        \\\\\\\"task_timestamp\\\\\\\": 1234567890,\\\\n    },\\\\n    \\\\\\\"compute_output\\\\\\\": {\\\\n        \\\\\\\"gn_weight\\\\\\\": 1450.0,  # G_n weight (BFLOPs)\\\\n        \\\\\\\"execution_time_ms\\\\\\\": 435,\\\\n        \\\\\\\"encrypted_result\\\\\\\": \\\\\\\"0x...\\\\\\\",\\\\n    },\\\\n    \\\\\\\"attestation\\\\\\\": {\\\\n        \\\\\\\"tee_type\\\\\\\": \\\\\\\"NVIDIA_HOPPER_CC\\\\\\\",\\\\n        \\\\\\\"hardware_pubkey\\\\\\\": \\\\\\\"0x...\\\\\\\",\\\\n        \\\\\\\"quote_hex\\\\\\\": \\\\\\\"0x...\\\\\\\",  # Raw TEE quote\\\\n        \\\\\\\"signature\\\\\\\": \\\\\\\"0x...\\\\\\\",  # Miner signature\\\\n    },\\\\n}\\\\n```\\\\n\\\\n### Supported TEE Types\\\\n\\\\n| TEE Type | Hardware | Production Ready |\\\\n|----------|----------|------------------|\\\\n| `NVIDIA_HOPPER_CC` | H100, H200 | \u2705 Yes |\\\\n| `NVIDIA_RUBIN_CC` | B100, B200 | \u2705 Yes |\\\\n| `CPU_WRAPPED_TEE` | RTX 4090+ + AMD SEV/Intel TDX | \u26a0\ufe0f Testnet only |\\\\n\\\\n### TEE Verification\\\\n\\\\nThe `NvidiaTeeBridge` validates TEE quotes with:\\\\n\\\\n- **Timestamp freshness:** Quotes must be < 60 seconds old\\\\n- **Signature verification:** Validates miner signature\\\\n- **Replay protection:** Tracks task hashes to prevent double-spending\\\\n- **Hardware verification:** Checks hardware keys against registry (production only)\\\\n\\\\n```python\\\\nfrom flop_sdk.tee import NvidiaTeeBridge, PouiPayload\\\\n\\\\nbridge = NvidiaTeeBridge(simulator_mode=False)\\\\n\\\\n# Register known hardware keys (production)\\\\nbridge.register_hardware_key(\\\\\\\"0x...\\\\\\\")\\\\n\\\\n# Verify TEE quote\\\\npayload: PouiPayload = parse_tee_quote(quote_json)\\\\nresult = bridge.verify(payload)\\\\n\\\\nif result.valid:\\\\n    print(f\\\\\\\"\u2713 TEE verified: {result.gn_weight} G_n\\\\\\\")\\\\nelse:\\\\n    print(f\\\\\\\"\u2717 Verification failed: {result.error}\\\\\\\")\\\\n```\\\\n\\\\nFor complete setup instructions, hardware requirements, and production deployment guide:\\\\n\\\\n- **[NVIDIA GPU Operator SDK Guide](../../docs/NVIDIA_GPU_OPERATOR_SDK.md)** - Complete API reference, dstack integration, production workflows\\\\n- **[NVIDIA GPU Operator Guide](../../docs/tutorials/NVIDIA_GPU_OPERATOR_GUIDE.md)** - Hardware setup, TEE configuration, monitoring\\\\n\\\\n## License\\\\n\\\\nApache-2.0 \u00a9 FLOP Network\\\\n\\\\n## Links\\\\n\\\\n- [FLOP Network Documentation](https://github.com/flop-labs/flop-core)\\\\n- [RPC API Reference](../../docs/RPC_API.md)\\\\n- [TypeScript SDK](../typescript/README.md)\\\\n\\\",\\\"description_content_type\\\":\\\"text/markdown\\\",\\\"docs_url\\\":null,\\\"download_url\\\":null,\\\"downloads\\\":{\\\"last_day\\\":-1,\\\"last_month\\\":-1,\\\"last_week\\\":-1},\\\"dynamic\\\":null,\\\"home_page\\\":null,\\\"keywords\\\":\\\"ai, blockchain, flop, htlc, inference, substrate, tee\\\",\\\"license\\\":\\\"MIT OR Apache-2.0\\\",\\\"license_expression\\\":null,\\\"license_files\\\":[\\\"LICENSE\\\"],\\\"maintainer\\\":null,\\\"maintainer_email\\\":null,\\\"name\\\":\\\"flop-sdk\\\",\\\"package_url\\\":\\\"https://pypi.org/project/flop-sdk/\\\",\\\"platform\\\":null,\\\"project_url\\\":\\\"https://pypi.org/project/flop-sdk/\\\",\\\"project_urls\\\":{\\\"Documentation\\\":\\\"https://github.com/flop-labs/flop-core/docs\\\",\\\"Homepage\\\":\\\"https://github.com/flop-labs/flop-core\\\",\\\"Repository\\\":\\\"https://github.com/flop-labs/flop-core\\\"},\\\"provides_extra\\\":[\\\"dev\\\"],\\\"release_url\\\":\\\"https://pypi.org/project/flop-sdk/0.2.0/\\\",\\\"requires_dist\\\":[\\\"aiohttp>=3.9.0\\\",\\\"langfuse<3,>=2.0.0\\\",\\\"pydantic>=2.0.0\\\",\\\"substrate-interface>=1.0.0\\\",\\\"typing-extensions>=4.0.0\\\",\\\"pytest-asyncio>=0.21.0; extra == \\\\\\\"dev\\\\\\\"\\\",\\\"pytest-cov>=4.1.0; extra == \\\\\\\"dev\\\\\\\"\\\",\\\"pytest>=7.4.0; extra == \\\\\\\"dev\\\\\\\"\\\",\\\"ru"
